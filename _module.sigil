@integrations/editor/vscode/_module.sigil from SigilVsCodeExtension import { ExtensionPackage }
@packages/lsp/_module.sigil from SigilLsp import { LspPackage }
@packages/sigilc/_module.sigil from SigilSemanticCompiler import { FrontendBoundary }
@packages/cli/_module.sigil from SigilCli import { CliInvocation, DesignExport }
@packages/core/_module.sigil from SigilCore import { CorePackage }
@spec/language.sigil from SigilWorkspaceConfig import { WorkspaceBoundary, ConfigFile }
@spec/language.sigil from SigilLanguage import { LanguageVersion, ComponentContract, TagIdentity }

component Sigil {
  goal {
    Enable humans and coding agents to preserve, inspect, and evolve software
    rationale through one versioned language and toolchain.

    Keep deterministic language facts separate from host-assisted semantic judgment
    and explicit human approval.
  }

  interface {
    ComponentContractOverview {
      ComponentContractOverview adapts ComponentContract for the root boundary.

      lets humans and coding agents share durable public contracts and operational
      rationale for coherent software parts
    }

    WorkspaceBoundarySelection {
      WorkspaceBoundarySelection adapts WorkspaceBoundary for root tool selection.

      lets tools select a configured workspace and discover its included Sigil
      sources consistently
    }

    TagSelectionGuarantee {
      TagSelectionGuarantee exposes the TagIdentity contract at the root boundary.

      keeps every component-owned Tag selectable through an explicit declaring file,
      provider component, and exact Tag name
    }

    ToolchainSurfaces {
      provides non-interactive command-line automation, editor-neutral language
      intelligence, and a VS Code authoring surface

      CliInvocation, LspPackage, and ExtensionPackage provide the command-line,
      language-server, and VS Code surfaces through their owning components

      keeps command-line and language-server operations from modifying .sigil source,
      except for explicitly requested CLI source formatting
    }

    SkillWorkflowIntegration {
      SkillWorkflowIntegration integrates SkillWorkflow into the host-neutral root
      workflow.

      provides a host-neutral agent workflow for design clarification, semantic
      review, explicit approval, and Sigil-guided implementation
    }

    SemanticCompilation {
      Use CliInvocation for authored-language operations and DesignExport for
      structural export. Invoke SigilSemanticCompiler through standalone sigilc for
      deterministic preparation, ingestion, freshness, catalog and semantic gates.
      External workers interpret captured source; models do not supply verdicts. Keep
      source editing and orchestration outside both compiler binaries.
    }
  }

  state {
    ReleaseMaturity {
      Sigil artifacts are pre-production.
    }
  }

  logic {
    DeterministicSemantics {
      Core computes parsing, configuration, workspace, resolution, graph, projection,
      and diagnostic facts shared by toolchain surfaces.
    }

    SkillWorkflow {
      The host skill applies semantic judgment, conducts design and review
      conversations, and honors the user's existing authorization for scoped Sigil
      and implementation.

      Writing and evaluation use a verified compatible CLI for mechanical checks
      when available. Writing checks the real workspace, applies supported
      corrections, formats only authored targets, and rechecks before capturing
      exact bytes for fresh independent review. Evaluation runs check and fmt
      --check without modifying sources.
    }

    SemanticCompilation {
      CorePackage parses and resolves authored Sigil. SigilSemanticCompiler validates
      its structural bundle under FrontendBoundary and its source-local Turtle, then
      saturates Design and Implementation separately under fixed laws. Design yields
      obligations; comparison checks those obligations against Implementation
      closure.
    }
  }

  constraints {

    CurrentAndHistoricalDesign {
      Bind current designs to [the reference](spec/sigil-reference.md),
      [grammar](spec/sigil.ebnf), and [migration guide](spec/migrating-to-0.8.md).
      These designs specify intended 0.8 behavior pending implementation and do not
      claim legacy compiler validation or current implementation conformance.

      Retain [the historical skill](integrations/skills/sigil/SKILL.md) as frozen 0.7
      material outside active 0.8 discovery and compatibility. The current
      [understanding](integrations/skills/sigil-understand/SKILL.md),
      [writing](integrations/skills/sigil-write/SKILL.md), and
      [evaluation](integrations/skills/sigil-evaluate/SKILL.md) siblings own current
      design workflows.
    }

    RootLanguageVersion {
      LanguageVersion owns the single language and workspace-configuration version
      literal.
    }

    ArtifactVersionOwnership {
      Package and integration manifests own distributable artifact versions; the root
      Sigil contract does not duplicate them.
    }

    RootComponentContract {
      ComponentContract requires every component to declare all of its contracts
      together; trivial reconstructable mechanics need no separate component. Facets
      retain their owner and contract role.
    }

    RootWorkspaceConfiguration {
      ConfigFile is the sole authority for selecting a Sigil workspace root and its
      declared members.
    }

    ModuleIndexFile {
      _module.sigil is an ordinary source with no directory-import, namespace,
      re-export, or workspace-discovery authority.
    }

    ToolchainSurfaces {
      CLI and LSP workspace operations report or project Sigil semantics without
      modifying .sigil source, except explicit source-formatting commands scoped to
      the selected Sigil files.
    }

    SkillWorkflow {
      Host-assisted semantic judgment remains outside deterministic core packages.

      Current understanding, writing, and independent evaluation follow the sibling
      skills and the user existing scoped authorization. Undecided consequential
      policy remains human-owned; determined preservation corrections proceed
      autonomously.

      Mechanical observations identify the actual CLI, workspace, selected targets,
      assessed bytes, outcomes, and diagnostics separately from semantic findings.
      Configuration and other CLI inputs remain part of that observation's scope.
      A captured review claims live mechanical evidence only when the relevant
      inputs match the captured revision before and after the commands.

      Missing or incompatible tooling, unavailable workspace context, or denied
      access leaves mechanical validation unavailable while design work continues.
      Completed diagnostics remain findings, never unavailable or clean results.
      Mechanical success proves neither design coherence nor implementation
      conformance. Formatting after capture invalidates review freshness, and
      unrelated workspace diagnostics never authorize broader source edits.
    }

    SemanticCompilation {
      Native sigilc owns semantic laws, content identity and disposable worlds.
      Independent Implementation workers receive exactly one captured source, the
      fixed ontology and the frozen Design identity catalog, without Design prose or
      relationships. No provider framework, compiler facade, receipt verifier,
      accepted-world store or legacy event protocol remains. Coherent and Loose
      Design exit 0; Disjoint exits 1. Closed and Converged Implementation exit 0;
      Drift exits 1. Usage and runtime/unavailable results are not semantic verdicts.
      Gate success never proves software delivery.
    }

    ReleaseMaturity {
      Pre-production artifacts make no production-readiness or compatibility
      guarantee beyond their declared versioned contracts.
    }
  }

  decisions {
    SemanticCompilation {
      Decision: Keep language interpretation in the existing frontend and put
      deterministic semantic compilation in one Rust binary. Scope: Governs compiler,
      CLI, CI and editor boundaries; external workers own model calls and independent
      reconstruction, and external workflows own edits. Trade-offs: Callers pass a
      captured structural bundle explicitly; native sigilc does not parse the
      authored Sigil language or invoke its frontend. Consequences: Delete the
      TypeScript compiler and adapter packages rather than preserve compatibility
      dispatch or duplicate semantic laws.
    }
  }

  cases {
    DeterministicSemantics {
      CLI and LSP consumers resolving the same configured workspace receive semantics
      derived from the same core contracts.
    }

    SkillWorkflow {
      A consequential policy not settled by supplied intent remains visible for human
      decision; intent-preserving corrections follow current writing/evaluation
      guidance.
    }

    ArtifactVersionOwnership {
      Changing a distributable artifact version updates its owning manifest without
      requiring a duplicate root-contract version edit.
    }

    SemanticCompilation {
      The language CLI exports structural Design without a semantic runtime. Native
      preparation and ingestion produce disposable source-local objects; global
      closure derives shared meaning without a model-owned verdict. The editor
      consumes native named states and diagnostics directly. A scoped green result
      never authorizes deployment or proves full delivery.
    }
  }
}
