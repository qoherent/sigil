@spec/language.sigil import { SigilLanguage, SigilWorkspaceConfig, SigilModuleIndex }
@packages/core import { SigilCore }
@packages/cli import { SigilCli }
@packages/compiler import { SigilCompiler }
@packages/lsp import { SigilLsp }
@integrations/editor/vscode import { SigilVsCodeExtension }
@integrations/skills/sigil import { SigilSkill }

component Sigil {
  goal {
    Enable humans and coding agents to preserve, inspect, and evolve software
    rationale through one versioned language and toolchain.

    Keep deterministic language facts separate from host-assisted semantic judgment
    and explicit human approval.
  }

  interface {
    ComponentContractOverview {
      ComponentContractOverview adapts ComponentContract for the root boundary.

      lets humans and coding agents share durable public contracts and operational
      rationale for coherent software parts
    }

    WorkspaceBoundarySelection {
      WorkspaceBoundarySelection adapts WorkspaceBoundary for root tool selection.

      lets tools select a configured workspace and discover its included Sigil
      sources consistently
    }

    DirectoryImportSurfaceExposure {
      DirectoryImportSurfaceExposure re-exposes DirectoryImportSurface through the
      root boundary.

      lets authors use intentional directory-import shorthand
    }

    ComponentVisibilityGuarantee {
      ComponentVisibilityGuarantee adapts ComponentVisibility into a root-level
      visibility promise.

      keeps every component importable through its explicit Sigil source path
      regardless of directory-import shorthand
    }

    ToolchainSurfaces {
      provides non-interactive command-line automation, editor-neutral language
      intelligence, and a VS Code authoring surface

      keeps command-line and language-server operations from modifying .sigil source
    }

    SkillWorkflowIntegration {
      SkillWorkflowIntegration integrates SkillWorkflow into the host-neutral root
      workflow.

      provides a host-neutral agent workflow for design clarification, semantic
      review, explicit approval, and Sigil-guided implementation
    }

    AgenticCompilation {
      provides profile-scoped, read-only, evidence-backed compilation through shared
      compiler, CLI, CI, and editor surfaces

      distinguishes compilation status from human design approval and implementation
      authorization
    }
  }
}

expand Sigil {
  state {
    ReleaseMaturity {
      Sigil artifacts are pre-production.
    }
  }

  logic {
    DeterministicSemantics {
      Core computes parsing, configuration, workspace, resolution, graph, projection,
      and diagnostic facts shared by toolchain surfaces.
    }

    SkillWorkflow {
      The host skill applies semantic judgment, conducts design and review
      conversations, and uses ReviewGate for scoped approval of Sigil changes and
      implementation.
    }

    AgenticCompilation {
      SigilCompiler combines deterministic SigilCore evidence with bounded agentic
      evaluation while thin host façades present the shared result.
    }
  }

  constraints {
    LanguageVersion {
      SigilLanguage owns the single language and workspace-configuration version
      literal.
    }

    ArtifactVersionOwnership {
      Package and integration manifests own distributable artifact versions; the root
      Sigil contract does not duplicate them.
    }

    ComponentContract {
      Public contracts live in components, operational rationale lives in matching
      expands, and trivial reconstructable mechanics need no separate component.
    }

    ConfigFile {
      ConfigFile is the sole authority for selecting a Sigil workspace root and its
      declared members.
    }

    ModuleIndexFile {
      ModuleIndexFile defines directory-import shorthand and has no
      workspace-discovery authority.
    }

    ToolchainSurfaces {
      CLI and LSP workspace operations report or project Sigil semantics without
      modifying .sigil source.
    }

    SkillWorkflow {
      Host-assisted semantic judgment remains outside deterministic core packages.

      The review workflow remains host-neutral and requires explicit human approval
      before semantic Sigil edits or implementation.
    }

    AgenticCompilation {
      Agentic compilation remains outside SigilCore and does not modify selected
      workspace content.

      Green status is scoped to one source snapshot, profile, stage set, and
      evaluator environment.
    }

    ReleaseMaturity {
      Pre-production artifacts make no production-readiness or compatibility
      guarantee beyond their declared versioned contracts.
    }
  }

  decisions {
    AgenticCompilation {
      Decision: Introduce a separate shared compiler for profile-scoped agentic
      evaluation while retaining deterministic semantics in SigilCore.

      Scope: Governs compiler, CLI, CI, and editor compilation surfaces; excludes
      human approval and implementation authorization.

      Trade-offs: The platform gains a provider-adapter and report-version
      compatibility boundary.

      Design issues addressed: Designers need an iterative compiler-like path from
      errors through warnings to green without conflating model judgment with
      deterministic language facts.

      Consequences: Every host consumes the same evidence-backed compilation protocol
      and status semantics.
    }
  }

  cases {
    DeterministicSemantics {
      CLI and LSP consumers resolving the same configured workspace receive semantics
      derived from the same core contracts.
    }

    SkillWorkflow {
      A material semantic change remains unedited until the exact Sigil proposal
      receives explicit human approval.
    }

    ArtifactVersionOwnership {
      Changing a distributable artifact version updates its owning manifest without
      requiring a duplicate root-contract version edit.
    }

    AgenticCompilation {
      The same source snapshot and effective profile produce one shared report
      contract across CLI, CI, and VS Code.

      A green compilation result remains subject to explicit human design approval.
    }
  }
}
