@spec/language.sigil import { SigilLanguage }

component SigilWorkspaceGlossary {
  goal {
    Define the optional reviewed vocabulary authority for one configured Sigil
    workspace.

    Give authors and deterministic tools unambiguous workspace-wide and
    bounded-context meanings without changing Sigil source syntax or concept
    identity.
  }

  interface {
    GlossaryFile {
      filename: .sigil/glossary.json

      location: workspace root

      absence leaves glossary features inactive without invalidating the workspace
    }

    GlossarySchema {
      schemaVersion: 1

      the top-level strict JSON object contains schemaVersion, terms, and contexts

      terms and contexts are required arrays and may be empty

      unknown properties are invalid
    }

    GlossaryEntry {
      term is a non-empty canonical spelling

      definition is a non-empty reviewed meaning

      aliases is an optional array of unique non-empty alternative spellings

      agentContext is an optional boolean that defaults to true

      agentContext false excludes the entry from agent-facing scoped glossary context
    }

    BoundedContext {
      id matches [A-Za-z][A-Za-z0-9_-]* and is unique without regard to case

      include is a non-empty array of workspace-relative POSIX globs

      exclude is an array of workspace-relative POSIX globs

      terms is an array of GlossaryEntry values
    }

    ContextResolution {
      workspace terms are available to every included Sigil source

      a Sigil source matches at most one bounded context

      context terms override workspace terms with the same case-insensitive spelling
      in that source
    }

    TermRecognition {
      canonical terms and aliases match case-insensitively as whole words or phrases

      the longest matching phrase wins

      occurrences resolve only inside SemanticUnit prose

      structural syntax, LiteralBlock types and bodies, inline code, and URLs do not
      contain glossary occurrences
    }
  }
}

expand SigilWorkspaceGlossary {
  logic {
    ContextResolution {
      Resolve context include and exclude globs against normalized workspace-relative
      source paths.

      Combine workspace entries with the one matched context.

      Replace a workspace spelling with the matched context entry that owns the same
      case-insensitive canonical or alias spelling.
    }

    TermRecognition {
      Order effective canonical and alias spellings by descending length before
      scanning each eligible semantic unit.

      Accept a match only when adjacent characters are not Unicode letters, numbers,
      or underscore.

      Preserve the canonical entry, matched spelling, context, source file, and exact
      occurrence range.
    }
  }

  constraints {
    GlossaryFile {
      GlossaryFile is UTF-8 JSON interpreted independently from Sigil source include
      globs.

      The glossary summarizes approved terminology and does not override an approved
      normative contract.
    }

    GlossarySchema {
      Every nested object is strict and rejects unknown properties.

      A structurally invalid glossary contributes no authoritative term definitions.
    }

    GlossaryEntry {
      Canonical terms and aliases are unique without regard to case within one scope.

      One spelling cannot resolve to multiple entries in the same effective context.

      A glossary entry does not create, import, alias, or shadow a Sigil concept
      identity.

      Agent-context exclusion does not affect glossary authority, validation, term
      recognition, glossary inspection, or editor features.
    }

    BoundedContext {
      Context globs cannot escape the workspace.

      Matching more than one context is invalid and context order never selects a
      winner.
    }

    TermRecognition {
      Deterministic recognition never infers an unknown term or definition from
      prose.

      Matching does not alter Sigil source or GlossaryFile.
    }
  }

  decisions {
    GlossaryFile {
      Decision: Use an optional committed strict-JSON GlossaryFile as human-reviewed
      terminology authority.

      Scope: Governs workspace and bounded-context vocabulary; excludes behavioral
      contracts and Sigil concept identity.

      Trade-offs: Teams maintain an additional reviewed JSON artifact.

      Discarded alternatives: Generated authority, Markdown authority, and new
      glossary syntax inside Sigil source were rejected.

      Consequences: Approved normative Sigil remains authoritative during conflicts
      and GlossaryFile must be corrected explicitly.

      Revisit when: JSON maintenance becomes impractical or another format can
      provide equivalent strict validation and review.
    }

    ContextResolution {
      Decision: Resolve workspace terminology plus at most one path-glob-bounded
      context for each Sigil source.

      Scope: Governs effective glossary-entry selection for loaded Sigil sources;
      excludes workspace membership and component resolution.

      Trade-offs: Overlapping contexts are invalid instead of being resolved by
      ordering.

      Discarded alternatives: One global namespace and mandatory per-source context
      annotations were rejected.

      Consequences: Context-local spellings may replace workspace spellings only
      within their matched source boundary.

      Revisit when: Repository paths cannot represent common terminology boundaries
      safely.
    }

    AgentContextVisibility {
      Decision: Allow each glossary entry to opt out of agent-facing scoped context
      with agentContext false while defaulting omitted values to true.

      Scope: Governs GlossaryContextProjection supplied to agent context; excludes
      glossary validation, recognition, inspection, and editor behavior.

      Trade-offs: Consumers must distinguish complete glossary projections from
      agent-facing scoped projections.

      Design issues addressed: Workspace conventions may already be known to an agent
      and would otherwise consume context with duplicated explanations.

      Discarded alternatives: A glossary-wide exclusion flag was rejected because
      project terminology and conventional terminology may coexist in one
      GlossaryFile.

      Consequences: Existing schemaVersion 1 files retain their current behavior
      because omitted agentContext values remain included.

      Revisit when: Context consumers require named audiences or more than included
      and excluded visibility.
    }
  }

  cases {
    ContextResolution {
      A source matching no context receives workspace terms only.

      A context definition of hold replaces the workspace definition of hold only for
      sources matched by that context.

      A source matched by two contexts produces SIGIL_GLOSSARY_CONTEXT_OVERLAP.
    }

    TermRecognition {
      workspace root matches before workspace when both entries exist.

      An alias occurrence resolves to its canonical entry.

      A term inside inline code or a URL remains ordinary text.

      Two local entries claiming the same case-insensitive spelling produce
      SIGIL_GLOSSARY_TERM_COLLISION.

      A recognized entry with agentContext false remains visible to glossary
      inspection and editor features but is absent from agent-facing scoped context.
    }
  }
}
