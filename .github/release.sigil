@integrations/editor/vscode/_module.sigil from SigilVsCodeExtension import { ExtensionPackage, installable VSIX, VSIX }
@packages/cli/src/installer.sigil from SkillInstaller import { SkillCatalog, SkillCompatibility }
@packages/sigilc/claims.sigil from SigilComputedClaims import { ClaimsCommands }
@packages/sigilc/_module.sigil from SigilSemanticCompiler import { SourceTrees }
@_module.sigil from Sigil import { ArtifactVersionOwnership }
@packages/cli/_module.sigil from SigilCli import { CliInvocation }

component SigilReleaseDistribution {
  goal {
    Distribute *native Sigil CLI archives*, bundled agent skills, and an
    installable
    VS Code extension through GitHub Releases.

    Let users install *released artifacts* without first installing Deno, Node.js,
    or
    a package-registry client.
  }

  logic {
    NativeCliRelease {
      Validate that the release tag agrees with the *CLI manifest* before building
      assets.

      Compile x86_64 and *ARM64 executables* for macOS and Linux and x86_64 for
      Windows.

      Package stable *platform-specific archive names* containing versioned
      bin/sigil, bin/sigilc, bin/sigil-claims, and integrations/skills paths.
      Each binary reports its owning manifest version; the archive version follows
      the language CLI manifest.

      Detect *host operating system* and architecture before selecting an archive.

      Download the archive and *checksum manifest* from the same release.

      Verify SHA-256 before extracting or changing the *active executable*.

      Install into a *versioned user-data* directory and expose all three selected
      executables through a user PATH directory. Verify all three binaries before
      activation. Reinstallation checks existing bytes against the verified archive,
      including skills; corrupt existing installations fail without selecting a new
      version.
    }

    VsCodeRelease {
      Run *verification*, build the bundled extension and language server, package
      one
      VSIX, and upload it as a release asset.
    }
  }

  constraints {

    LegacySkillIsolation {
      Include every valid skill in the catalog while labeling sigil as legacy 0.7
      with frozen *incompatible requirements* in catalog and install output. Keep
      its subtree outside active 0.9 workspace discovery, with no active import or
      implementation annotation depending on excluded legacy declarations.

      Separate static legacy-package validation and explicitly selected legacy-binary
      smoke from current 0.9 acceptance. Preserve the *old validator* and its fixture
      unchanged; add a current schema 2 native protocol fixture for current released
      binaries. Language, source tree, and native report compatibility must
      agree before support is advertised.
    }

    DistributionInputs {
      Package the language executable under CliInvocation and
      ArtifactVersionOwnership, the native compiler under SourceTrees, the
      claims command under ClaimsCommands, the SkillCatalog with its declared
      SkillCompatibility, and the VSIX under ExtensionPackage. Each input retains
      its provider component and manifest ownership.
    }

    ReleaseIntegrity {
      GitHub Release assets are the *durable public binary distribution* channel;
      workflow artifacts are build intermediates.

      A release tag must agree with the *owning artifact manifest*.

      Installation scripts fail without replacing the *active version* when download,
      checksum, or extraction fails.
    }

    NativeCliRelease {
      Installation scripts reject combinations with an unsupported *operating system*
      or unsupported *architecture*.

      Default *user-scoped installation* requires no administrator privileges.

      Pre-production *native executables* may remain unsigned and release
      documentation
      identifies that limitation.

      Future signing must preserve archive names and *installer commands*.
    }

    VsCodeRelease {
      The VSIX is distributed through GitHub Releases and not through an extension
      marketplace.
    }
  }

  cases {
    NativeCliRelease {
      Apple Silicon macOS and supported Linux users install
      *matching native archives*
      without host Deno, Node, npm, Rust or TypeScript tools.

      Matching *native runners* build and execute every retained target. Relocated
      archives export structural Design with sigil, run native scope, preparation,
      ingestion and gates directly with sigilc using fixed fixtures, and expose
      sigil-claims to run the computed claims workflow. Runtime errors are distinct
      from named Design and Implementation states. No legacy bridge, TypeScript
      proof runtime, runtime manifest or compiler wrapper is packaged.
      Repository-local repos dependencies are unnecessary.

      SIGIL_VERSION selects the *requested release*.

      Windows installation requires no *developer-mode symlink* privilege.

      A *checksum mismatch* leaves the previously active executable unchanged.

      An unsupported platform fails without downloading an *unrelated executable*.
    }

    VsCodeRelease {
      A user downloads the VSIX from GitHub Releases and installs it through VS Code
      Install from VSIX.
    }
  }

  interface {
    NativeCliRelease {
      a cli-vX.Y.Z GitHub Release provides *native CLI archives* for supported macOS,
      Linux, and Windows targets

      each archive contains the *language executable* sigil, the independent semantic
      compiler sigilc, the computed claims command sigil-claims, and the
      distribution-version-matched skill catalog

      install.sh installs the latest or explicitly selected *macOS CLI release*
      or *Linux CLI release*

      install.ps1 installs the latest or explicitly selected *Windows CLI release*

      SIGIL_VERSION selects an *explicit CLI release* version in both installers
    }

    VsCodeRelease {
      a vscode-vX.Y.Z GitHub Release provides one installable VSIX
    }
  }

  decisions {
    NativeCliRelease {
      Decision: Distribute native CLI archives with version-matched agent skills
      through versioned GitHub Releases.

      Scope: Governs released CLI archives, bundled skills, and user-scoped
      installers; excludes *source-development* and package-registry installation.

      Trade-offs: Maintainers build and test a *platform matrix* and pre-production
      executables may remain unsigned.

      Consequences: Three *selected executables* and their bundled skills form a
      consistent installation unit.

      Revisit when: Package-manager or signed distribution provides equivalent
      *runtime independence* and version ownership.
    }

    ReleaseIntegrity {
      Decision: Verify downloaded release assets before activation and preserve the
      *currently active version* when installation fails.

      Scope: Governs release checksum publication and installer download,
      verification, extraction, and activation; excludes *future code-signing*
      policy.

      Trade-offs: Releases and installers must maintain a checksum manifest and
      staged *activation flow*.

      Consequences: Download, *archive checksum*, and extraction failures leave the
      active
      executable unchanged.

      Revisit when: Platform signing and package-manager verification replace
      *checksum-based integrity*.
    }

    VsCodeRelease {
      Decision: Distribute the *pre-production VSIX* through GitHub Releases until an
      approved extension-marketplace publisher identity exists.

      Scope: Governs public VSIX distribution; excludes *local development packages*
      and future marketplace publication.

      Trade-offs: Users install the VSIX manually and receive less marketplace
      discovery and update automation.

      Consequences: Release tags and the extension manifest remain the version
      *authorities* for downloadable VSIX assets.

      Revisit when: An approved publisher identity and *marketplace-release process*
      are available.
    }
  }
}
