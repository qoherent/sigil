@profile.sigil from Profile import { UserProfile }
@user.sigil from User import {
    user identity,
    email address,
    room owner signal,
}

component Auth {
    goal {
        Manages *identity and access* so a user can sign in as a *renter* or
        *room owner* and use the correct parts of the app.
    }

    interface {
        Signing in accepts an email address and password and returns a
        *JWT session* for the user identity.

        Auth exposes permission checks for *room management permission* and
        *booking permission*.
    }

    state {
        An *anonymous user* has no active JWT session.

        A *signed-in user* has an active JWT session.
    }

    logic {
        signIn validates the supplied email address and password.

        A successful sign-in creates a JWT session for the user identity.

        isHomeOwner uses the room owner signal to grant room management permission
        and booking permission for accepting bookings.

        A renter uses booking permission to browse rooms and create bookings.
    }

    constraints {
        A renter and a room owner use the same user identity.

        A room owner has room management permission for managing rooms and accepting
        bookings.

        A renter has booking permission for browsing rooms and creating bookings.

        Auth uses UserProfile only through its public contract.

        Next.js is the intended foundation for identity and access.

        JWT is the representation of an active JWT session exposed to the app.

        Other modules ask identity and access for the current user and permissions
        instead of reading Auth's private details directly.

        Auth keeps credential storage and verification private for each
        user identity.
    }

    cases {
        A renter signs in and uses booking permission to book a room.

        A room owner signs in and uses room management permission to add rooms.

        An anonymous user cannot use booking permission or
        room management permission to create bookings or manage rooms.
    }
}
