@user.sigil from User import { user identifier }
@auth.sigil from Auth import { identity and access, renter, room owner }
@profile.sigil from Profile import {
    UserProfile,
    public profile summary,
    display name,
    profile-picture URL,
}
@resource-management.sigil from ResourceManagement import {
    Room,
    resource identifier,
    room metadata,
    base availability rules,
    requested time range,
    room availability answer,
}
@booking.sigil from Booking import {
    booking request,
    confirmed booking,
    booking conflict,
    cancellation record,
}
@scheduling-and-recurrence.sigil from SchedulingAndRecurrence import {
    recurring booking pattern,
    recurring booking series,
    series exception,
}
@booking-calendar-view.sigil from BookingCalendarView import {
    room calendar,
    selected date range,
}

component Slotted {
    goal {
        Slotted is a room-booking testbed that connects a room owner and a renter
        in one authenticated app.

        Room owners create and manage Room and room metadata with
        base availability rules.

        Renters create a booking request for a Room and requested time range,
        subject to booking conflict checks.

        The room calendar shows room availability and confirmed bookings for a
        selected date range.

        The *Slotted product* is intentionally small; its purpose is to test whether
        Sigil can preserve rationale from schema design through implementation and
        tests.
    }

    interface {
        Slotted accepts Room information and room metadata from room owners.

        Slotted accepts base availability rules from room owners.

        Slotted accepts booking request from renters.

        Slotted exposes Room search and room details to renters.

        Room and booking views can request the public profile summary for display.

        Slotted exposes confirmed booking, cancellation record, and
        booking conflict information.
    }

    state {
        A Room can be draft, available, unavailable, or archived.

        A booking request can be requested, confirmed, or canceled.

        A recurring booking pattern can produce a recurring booking series or one
        edited instance.

        The room calendar is derived from confirmed bookings, Rooms, and
        availability.
    }

    logic {
        A room owner publishes a Room with base availability rules.

        A renter searches available Rooms and creates a booking request for a
        requested time range.

        Booking checks identity and access, a Room's room availability answer,
        recurring booking pattern rules, and booking conflict before confirmation.

        A cancellation changes a confirmed booking while preserving its
        cancellation record.

        The room calendar reads contracts from Booking and Resource Management and
        shapes the data for presentation.
    }

    constraints {
        The Slotted product is a modular monolith with layered, domain-oriented
        modules.

        The Slotted product ships as a single Next.js app.

        The Slotted product uses explicit module contracts rather than direct access
        to another module's database tables or private logic.

        Each Slotted product module separates Presentation, Application, Domain,
        Infrastructure, and Contracts concerns where useful.

        *Domain logic* should be testable with zero mocks and zero I/O.

        Infrastructure is private to its owning Slotted product module.

        Shared contracts carry user identifier and resource identifier values.

        identity and access owns user identities, sessions, roles, and permission
        checks.

        UserProfile owns editable display fields such as display name and
        profile-picture URL.

        Resource Management owns Room, room metadata, and
        base availability rules.

        Booking owns booking request, booking conflict, booking lifecycle, and
        cancellation record rules.

        Scheduling and Recurrence owns recurring booking pattern,
        recurring booking series, and series exception.

        Calendar Read Model composes confirmed booking and Room data for the
        room calendar.

        Booking asks Resource Management for a room availability answer based on
        base availability rules.

        Other modules ask identity and access for the current user and permission
        checks.

        Notification is out of scope for the first implementation of the
        Slotted product but remains a known module boundary.

        The Slotted product uses Next.js, Neon Postgres, and Drizzle ORM.
    }

    cases {
        A room owner creates a Room and publishes its base availability rules.

        A renter creates a booking request for an available Room and time range.

        A booking conflict prevents a renter from booking a time range that overlaps
        an existing confirmed booking.

        A renter cancels a confirmed booking, and Slotted retains its
        cancellation record.

        The room calendar shows Rooms and confirmed bookings for a selected range.
    }
}
