{
  "sigilVersion": "0.9.0",
  "workspace": {
    "name": "sigil",
    "members": [
      "packages/cli",
      "packages/core",
      "packages/lsp",
      "integrations/editor/vscode",
      "packages/sigilc"
    ]
  },
  "files": {
    "include": [
      "**/*.sigil"
    ],
    "exclude": [
      ".git/**",
      ".deno/**",
      "node_modules/**",
      "build/**",
      "coverage/**",
      ".sigil/tmp/**",
      ".codex-progress/**",
      "repos/**",
      "**/target/**",
      "examples/**",
      ".benchmarks/**",
      "scripts/slotted-benchmark/fixtures/**",
      "packages/core/tests/**",
      "packages/cli/tests/**",
      "packages/lsp/tests/**",
      "integrations/editor/vscode/tests/**",
      "integrations/editor/vscode/dist/**",
      "integrations/editor/vscode/node_modules/**",
      "integrations/editor/vscode/build/**",
      "integrations/editor/vscode/.vscode-test/**"
    ]
  },
  "tools": {}
}
