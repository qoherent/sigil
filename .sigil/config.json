{
  "sigilVersion": "0.8.0",
  "workspace": {
    "name": "sigil",
    "members": [
      "packages/cli",
      "packages/core",
      "packages/lsp",
      "integrations/skills/sigil",
      "integrations/editor/vscode",
      "packages/sigilc"
    ]
  },
  "files": {
    "include": [
      "**/*.sigil"
    ],
    "exclude": [
      ".git/**",
      ".deno/**",
      "node_modules/**",
      "build/**",
      "coverage/**",
      ".sigil/tmp/**",
      ".codex-progress/**",
      "repos/**",
      "**/target/**",
      "examples/**"
    ]
  },
  "tools": {}
}
