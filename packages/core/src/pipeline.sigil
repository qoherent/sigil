@packages/core/src/glossary.sigil from SigilGlossaryEngine import { GlossaryInspection }
@packages/core/src/graph.sigil from SigilGraphBuilder import { GraphConstruction }
@packages/core/src/resolver.sigil from SigilResolver import { RelationshipResolution }
@packages/core/src/model/diagnostics.sigil from SigilDiagnosticModel import { DiagnosticModel }
@packages/core/src/model/glossary.sigil from SigilGlossaryModel import { GlossaryModel }
@packages/core/src/model/graph.sigil from SigilGraphModel import { GraphModel }
@packages/core/src/model/resolution.sigil from SigilResolutionModel import { ResolutionModel }
@packages/core/src/model/workspace.sigil from SigilWorkspaceModel import { WorkspaceModel }

component SigilWorkspaceResolutionPipeline {
  goal {
    Compose resolved workspace relationship, graph, and glossary data into one
    deterministic result for core consumers.

    Keep stage ordering, result assembly, and diagnostic deduplication separate
    from the individual resolver, graph, and glossary owners.
  }

  interface {
    WorkspaceResolution {
      resolveSigilWorkspace(workspace) accepts one already loaded SigilWorkspace and
      returns one ResolvedSigilWorkspace containing relationship data, graph data,
      glossary data, and merged diagnostics

      Malformed loaded documents and glossary data remain represented by partial
      results and diagnostics when the underlying stages can recover.

      The operation performs no filesystem access or configuration discovery;
      required dependency and runtime failures propagate to the caller.

      Each call is stateless and completes one pipeline operation without retaining a
      lifecycle or session.
    }
  }

  logic {
    WorkspaceResolutionPipeline {
      Consume the loaded WorkspaceModel through RelationshipResolution to obtain
      relationship data and diagnostics.

      Derive the workspace glossary projection through GlossaryInspection, then
      construct the relationship graph through GraphConstruction.

      Return one ResolvedSigilWorkspace containing resolution data, graph data,
      glossary data, and merged diagnostics.

      ResolutionModel, GraphModel, and GlossaryModel own the immutable result shapes;
      DiagnosticModel owns the diagnostic records consumed by the merge.

      Merge resolution and glossary diagnostics using the adopted diagnostic ordering
      and exact-record coalescing. Keep stage execution order separate from final
      diagnostic order, and retain stage and related-location evidence.
    }
  }

  constraints {

    WorkspaceResolutionPipeline {
      The pipeline consumes an already loaded SigilWorkspace and performs no source
      parsing, configuration discovery, or filesystem access.

      RelationshipResolution owns relationship interpretation, GraphConstruction owns
      graph construction, and GlossaryInspection owns glossary projection.

      The pipeline owns only stage ordering, result assembly, and exact diagnostic
      deduplication.
    }
  }

  cases {
    WorkspaceResolutionPipeline {
      A loaded workspace returns one resolved workspace containing relationship,
      graph, and glossary projections.

      Resolution and glossary diagnostics are combined without duplicate records.
    }
  }
}
