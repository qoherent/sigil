@spec/language.sigil import { SigilLanguage, SigilModuleIndex }
@packages/core/src/model import { SigilSemanticModel }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }

component SigilResolver {
  goal {
    Resolve component imports, their *qualifying local use*, collective
    expansions, and each contextual *Tag scope* across one
    *loaded workspace*.

    Produce deterministic *relationship data* and diagnostics without
    filesystem access, *graph construction*, or presentation.
  }

  interface {
    RelationshipResolution {
      resolveSigilRelationships(workspace) returns SigilResolution

      SigilResolution exposes the source workspace, resolved imports,
      resolved components, and accumulated diagnostics
    }

    ImportUse {
      each *resolved imported name* exposes whether and where it is used
      by qualifying component, `interface`-introduced Tag, or
      *structural-expand evidence*
    }

    CollectiveExpansions {
      each resolved component identifies its *declaration source* and
      every matching *expand block* colocated with it or connected
      through a resolved named import
    }

    TagResolution {
      each resolved component exposes local, `interface`-introduced,
      imported, and *accessible Tag* identities with
      *contextual occurrence* and references
    }
  }
}

expand SigilResolver {
  logic {
    RelationshipResolution {
      Index component and expand declarations by name across loaded
      documents.

      Diagnose duplicate components and expands without matching
      components.

      Resolve explicit source imports and directory imports.

      Diagnose every expand without a local or explicitly imported
      matching component and exclude it from collective expansions.

      Detect an *import cycle* between *resolved import* files.

      Diagnose each resolved imported name that has no qualifying local
      use.
    }

    ImportUse {
      Scan exact-case component names and imported
      `interface`-introduced Tag identities in interface, state, logic,
      constraints, and cases.

      Record an applicable local expand as *structural use* of its
      imported component.

      Preserve source ownership, section, kind, and exact range for
      every use.
    }

    DirectoryImportSurface {
      Resolve directory imports through ModuleIndexFile.

      Build each directory-import surface from local components and
      successfully resolved direct import names.

      Preserve original declaration files through chained module-index
      resolution.

      Do not add an *unnamed dependency* or other subtree files
      implicitly.
    }

    CollectiveExpansions {
      Collect only expands colocated with their component or connected to
      that exact component by a resolved import in the expand source,
      without override or shadowing.
    }

    TagResolution {
      Build one flat Tag scope from each component and its matching
      expands.

      Collect repeated Concepts as occurrences of one identity.

      Expose Tags introduced in `interface` and retain Tags introduced
      outside `interface` as unavailable to other components.

      Add imported Tags introduced in the provider's `interface` as bare
      accessible identities.

      Preserve *provider identity* only for an exact imported Concept
      introduced in the provider's `interface`, in a matching expand,
      while retaining importer lines only in importer context.

      Keep a same-named Concept declared on the importing component as a
      distinct local identity.

      Re-expose an imported identity when reused in a matching expand
      interface.

      Scan Facet prose against unambiguous accessible Tags and record
      each exact-case *whole-word match* in ResolvedTagScope.references.

      Diagnose different accessible identities whose names compare equal
      without regard to case.
    }
  }

  constraints {
    RelationshipResolution {
      Resolution consumes SigilSemanticModel data and emits
      SigilDiagnostics.

      Resolution performs no filesystem access.

      Missing or ambiguous relationships retain partial deterministic
      data when practical.
    }

    ImportUse {
      Use is evaluated separately for each imported name in its
      *declaring source document*.

      Goal, decisions, a *literal body*, comments, annotations, other
      source documents, case-mismatched text, and identifier substrings
      do not count as use.

      Unresolved or ambiguous imported names do not additionally produce
      *SIGIL_UNUSED_IMPORT*.

      A cross-file expand without a resolved import of its component
      produces *SIGIL_EXPAND_WITHOUT_COMPONENT* and contributes no
      collected expansion or Tag-scope content.
    }

    ComponentContract {
      Imported dependency projections expose public goals and interfaces
      without collected expansions.
    }

    TagResolution {
      Provider projections never collect consumer-contributed
      contextual occurrences.

      Component-declared Concepts do not adopt imported identities;
      same-named local and imported identities remain accessible and
      ambiguous.

      A *structural self-import* does not project the component's Tags
      introduced in `interface` into its own Tag scope as an imported
      dependency.

      Resolution provides no dotted qualification, aliases, or
      shadowing.

      A whole-word match is bounded by characters outside [A-Za-z0-9_-].

      Ambiguous identifiers, case-mismatched text, substrings, and
      unmatched words do not produce references.

      Unmatched words produce no unresolved-Tag diagnostic.

      A literal body produces no Tag references.
    }

    DependencyDirection {
      Graph construction and presentation projections remain outside
      SigilResolver.
    }
  }

  cases {
    RelationshipResolution {
      A valid named import connects its source file to the original
      component declaration.

      Missing sources or components produce stable diagnostics and
      partial import results.

      Duplicate components, unmatched expands, and import cycles produce
      stable diagnostics.

      One used and one unused component in the same import produce only
      one SIGIL_UNUSED_IMPORT.
    }

    ImportUse {
      A component name referenced only in goal or decisions does not use
      its import.

      An exact component reference in constraints uses its import.

      An imported Tag introduced in `interface` referenced in logic uses
      its provider import.

      A provider name appearing only in a EmbeddedContent does not use
      its import.

      A resolved direct ModuleIndexFile import without a qualifying
      semantic or structural use produces SIGIL_UNUSED_IMPORT.

      A cross-file expand without an import produces
      SIGIL_EXPAND_WITHOUT_COMPONENT.

      Importing the component attaches the cross-file expand and records
      structural-expand use.

      A second unused name in the same import still produces
      SIGIL_UNUSED_IMPORT.
    }

    DirectoryImportSurface {
      A name exposed by ModuleIndexFile resolves to its original
      declaration.

      An unnamed dependency remains unavailable through directory-import
      shorthand but remains explicitly importable.
    }

    CollectiveExpansions {
      Multiple matching expands are all retained.

      A structural self-import does not duplicate the component's Tags
      introduced in `interface`.
    }

    TagResolution {
      Imported Tags introduced in `interface` are available as bare
      identities.

      Matching-expand reuse preserves provider identity without adding
      importer content upstream.

      A same-named component-declared Concept remains a distinct local
      identity and produces an *ambiguity diagnostic*.

      A whole-word match of a local or imported identifier produces a
      contextual reference with its originating TagIdentity.

      A differently cased identifier or identifier embedded within a
      larger word produces no reference.

      Two reachable identities equal without regard to case produce an
      ambiguity diagnostic.

      Tags introduced outside the provider's `interface` and operational
      sections remain unavailable to importers.
    }
  }
}
