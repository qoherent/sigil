@packages/core/src/diagnostics.sigil from SigilDiagnostics import { DiagnosticConstruction }
@spec/language.sigil from SigilLanguage import { ImportSemantics, TagIdentity, SourceRecovery }
@packages/core/src/model/resolution.sigil from SigilResolutionModel import { ResolutionModel }

component SigilResolver {
  goal {
    Resolve explicit Tag selections and component-owned vocabulary collectively
    across one loaded workspace, retaining deterministic partial results.
  }

  interface {
    RelationshipResolution {
      resolveSigilRelationships(workspace) returns the ResolutionModel relationships,
      source workspace, components, import selections, Tag occurrences and
      references, and accumulated diagnostics.
    }

    ImportUse {
      Each resolved selection records qualifying bare-reference use in its source,
      including exact Facet owner, contract role, kind, and authoritative range.
    }

    TagResolution {
      Each component exposes its local and selected imported Tag identities, grouping
      occurrences, inline definitions, and actual consumer references.
    }
  }

  logic {
    RelationshipResolution {
      Apply ImportSemantics by indexing every component and local Tag introduction
      before resolving selections. Resolve each explicit
      owner-file/component/selected-name tuple against that owner. Preserve
      diagnostics for missing, duplicate, and ambiguous identities.

      Resolve collective mutual imports independently of source order; visited source
      and identity sets terminate cycles. Cycles alone are valid and do not establish
      requirement satisfaction.
    }

    TagResolution {
      TagIdentity combines one exact name and component owner regardless of
      occurrence order. Repeated grouping headings reuse that local identity; a
      second inline definition is invalid. A grouping heading never binds an imported
      identity.

      Match bare references on original physical lines against accessible exact
      names, using the normative complete-name boundaries and longest-match ordering.
      Preserve every qualifying range and its consumer-owned Facet.
    }

    ImportUse {
      All seven contracts can use selected Tags, including introducing prose before
      an embedded payload. Complete links and images and fenced payloads are inert.

      Diagnose duplicate selections, unknown selections, local/import collisions, and
      different accessible identities with the same exact spelling. A resolved unused
      selection is an error; unresolved or ambiguous selections do not also receive
      unused-import errors.
    }
  }

  constraints {
    LanguageAuthority {
      Follow [the normative reference](../../../spec/sigil-reference.md),
      [grammar](../../../spec/sigil.ebnf), and [migration
      guidance](../../../spec/migrating-to-0.8.md).
    }

    RelationshipResolution {
      Resolution performs no filesystem access, graph construction, or presentation.
      It consumes loaded source/model records and uses DiagnosticConstruction for
      findings. Invalid regions do not suppress independent valid results outside
      SourceRecovery boundaries.
    }

    TagResolution {
      Names are case-sensitive with no whitespace or Unicode normalization, aliases,
      dotted qualification, shadowing, or re-export. Unmatched ordinary words are not
      unresolved Tags. Directory imports and expansion collection do not exist.

      Provider interpretation uses its complete component declaration. Only selected
      names enter consumer scope. References never transfer a consumer Facet,
      contract role, implementation claim, or runtime obligation to the provider.
      Language importability does not create public/private runtime access policy.
    }
  }

  cases {
    RelationshipResolution {
      One valid and one invalid selection retain the valid identity and diagnostics
      for the invalid selection. An unused valid selection produces its own error.

      Mutual valid Tag selections terminate and preserve both owners. Invalid
      selections inside a cycle remain invalid.
    }

    TagResolution {
      A local grouping and one inline definition share one exact Tag identity;
      another inline definition conflicts. A same-spelled imported Tag collides.

      A longer complete accessible name wins an overlapping bare-reference match. A
      wrapped display paragraph cannot create a reference across physical lines. A
      link label or fenced example does not satisfy import use.
    }
  }
}
