@packages/core/src/model/source.sigil from SigilSourceModel import { SourceModel }
@packages/core/src/model/workspace.sigil from SigilWorkspaceModel import { WorkspaceModel }

component SigilResolutionModel {
  goal {
    Define immutable import, component, Tag, and contract-resolution data.
  }

  interface {
    ResolutionModel {
      SourceModel and WorkspaceModel provide input shapes. SigilResolution and its
      resolved imports, components, owner-scoped Tags, selected identities, bare
      references, and dependency contexts preserve relationship-resolution output.

      A Tag identity combines exact name and owner independently of occurrence
      order. Inline definitions and local grouping occurrences retain distinct
      evidence with each contribution's contract, Facet, and source location.
      Imported reuse preserves the originating identity without transferring
      consumer requirements upstream.

      Tag identity groups related contributions but does not establish behavioral
      equality. Direct Facets remain in their component's contracts without a
      synthetic Tag entry. All contracts remain available as provider context;
      only explicitly selected identities enter the importing source vocabulary.

      Duplicate definitions, duplicate selections, and name collisions retain
      conflicting evidence without an order-dependent winner. Independent valid
      names remain resolvable, and cycles terminate without supplying absent Tags.
    }
  }
}
