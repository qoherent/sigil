@packages/core/src/model/source.sigil from SigilSourceModel import { SourceModel }
@packages/core/src/model/workspace.sigil from SigilWorkspaceModel import { WorkspaceModel }

component SigilResolutionModel {
  goal {
    Define immutable import, component, Tag, and contract-resolution data.
  }

  interface {
    ResolutionModel {
      SourceModel and WorkspaceModel provide input shapes.
      *SigilResolution* and its *resolved imports*, *expansions*, *Tag scopes*,
      and *dependency contexts* preserve relationship-resolution output.

      Repeated Concept occurrences preserve their collective *Tag identity* and
      each contribution's *contract* and *source location*. *Imported reuse*
      preserves the originating Tag identity without transferring consumer
      requirements upstream.

      Tag identity groups related contributions but does not establish
      *behavioral equality*. *Direct Facets* remain in their component's
      sections without a *synthetic Concept entry*.
    }
  }
}
