@packages/core/src/model/language.sigil import { SigilLanguageModel }
@packages/core/src/model/diagnostics.sigil import { SigilDiagnosticModel }

component SigilSourceModel {
  goal {
    Define recovered Sigil source documents, Facets, and declarations for
    parsers and deterministic consumers.
  }

  interface {
    SourceModel {
      SigilLanguageModel supplies structural vocabulary and source positions, and
      SigilDiagnosticModel supplies diagnostics. *Facet*, *EmbeddedFacet*,
      *EmbeddedContent*, Concepts, *sections*, *declarations*, *SigilDocument*,
      *ParseResult*, *FormatResult*, and *ParseOptions* preserve recovered source
      structures and diagnostics.

      A Facet preserves its introducing prose, *source location*, *owner*,
      *contract*, optional *Concept name*, and any fenced EmbeddedContent.
      An EmbeddedFacet is the complete Facet with nonempty fenced content, not
      the fenced body alone.

      *isEmbeddedFacet* identifies the content-bearing form. Existing serialized
      units and *literalBlocks* field names remain stable while their TypeScript
      types use native Facet terminology.

      *Component* is the ownership container. A contract can freely mix direct
      Facets and multiple Concepts; an absent Concept name does not require a
      synthetic wrapper identity.

      Type documentation encourages Concepts for recurring cross-contract concerns
      and useful `interface`-introduced Tag identities while preserving direct
      shared guarantees and small single-concern components without redundant
      grouping.
    }
  }
}
