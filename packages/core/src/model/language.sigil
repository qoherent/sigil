@spec/language.sigil from SigilLanguage import { Component, Trait, Contract, Tag, StructuralVocabulary }

component SigilLanguageModel {
  goal {
    Keep the structural vocabulary used to understand a Sigil source consistent.
  }

  interface {
    shared vocabulary {
      StructuralVocabulary gives parsing, review, diagnostics, and navigation the
      same names for Component and Trait declarations, Contract sections, Tag
      ownership, conformance, imports, and source locations.
    }
  }

  decisions {
    shared vocabulary {
      Keep the language definition with SigilLanguage; this boundary only shares its
      vocabulary so each concern can describe one source without a competing meaning.
    }
  }
}
