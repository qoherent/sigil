@packages/core/src/model/source.sigil from SigilSourceModel import { SourceModel }
@packages/core/src/model/diagnostics.sigil from SigilDiagnosticModel import { DiagnosticModel }

component SigilImplementationOwnershipModel {
  goal {
    Define immutable ownership-annotation evidence and resolved implementation
    target data.
  }

  interface {
    OwnershipModel {
      SourceModel supplies annotation ranges and DiagnosticModel supplies
      diagnostics. ImplementationSource, ImplementationEvidenceInput, ownership
      relations, sections, artifacts, targets, and projections preserve annotation
      evidence.
    }
  }
}
