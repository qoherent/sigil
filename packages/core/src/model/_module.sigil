component SigilSemanticModel {
  goal {
    Summarize the independently owned immutable deterministic core
    model contracts without owning their domain behavior or data definitions.
  }

  interface {
    ModelNamespace {
      The [language](language.sigil), [configuration](configuration.sigil),
      [diagnostic](diagnostics.sigil), [source](source.sigil),
      [glossary](glossary.sigil), [ownership](ownership.sigil),
      [workspace](workspace.sigil), [resolution](resolution.sigil),
      [graph](graph.sigil), and [retrieval](retrieval.sigil) designs own their
      respective domain models.
    }
  }

  constraints {
    DomainModelAssembly {
      This ordinary summary describes domain model contracts only; each component
      owns its independently evolving immutable data shapes.
    }
  }

  decisions {
    DomainModelDecomposition {
      Decision: Split the former aggregate model contract into domain components and
      let consumers select needed Tags directly from their domain owners.

      Scope: Governs core model contract ownership and import paths; excludes
      operational parsing, loading, resolution, graph, and retrieval behavior.

      Trade-offs: Consumers use explicit owner imports where shared vocabulary is
      needed and documentary links for related context.

      Design issues addressed: Independently evolving model domains no longer
      converge on one ownership boundary.

      Consequences: Model changes remain localized while this ordinary source
      supplies
      documentary context without re-exporting vocabulary.
    }
  }
}
