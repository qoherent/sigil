@packages/core/src/model/retrieval.sigil from SigilRetrievalModel import { RetrievalModel }
@packages/core/src/model/graph.sigil from SigilGraphModel import { GraphModel }
@packages/core/src/model/resolution.sigil from SigilResolutionModel import { ResolutionModel }
@packages/core/src/model/workspace.sigil from SigilWorkspaceModel import { WorkspaceModel }
@packages/core/src/model/ownership.sigil from SigilImplementationOwnershipModel import { OwnershipModel }
@packages/core/src/model/glossary.sigil from SigilGlossaryModel import { GlossaryModel }
@packages/core/src/model/source.sigil from SigilSourceModel import { SourceModel }
@packages/core/src/model/diagnostics.sigil from SigilDiagnosticModel import { DiagnosticModel }
@packages/core/src/model/configuration.sigil from SigilConfigurationModel import { ConfigurationModel }
@packages/core/src/model/language.sigil from SigilLanguageModel import { LanguageModel }

component SigilSemanticModel {
  goal {
    Summarize the independently owned immutable deterministic core
    model contracts without owning their domain behavior or data definitions.
  }

  interface {
    ModelNamespace {
      LanguageModel, ConfigurationModel, DiagnosticModel, SourceModel, GlossaryModel,
      OwnershipModel, WorkspaceModel, ResolutionModel, GraphModel, and RetrievalModel
      retain their respective domain data definitions and independent component
      owners. This summary assembles their responsibilities without acquiring or
      re-exporting their Tags.
    }
  }

  constraints {
    DomainModelAssembly {
      This ordinary summary describes domain model contracts only; each component
      owns its independently evolving immutable data shapes.
    }
  }

  decisions {
    DomainModelDecomposition {
      Decision: Split the former aggregate model contract into domain components and
      let consumers select needed Tags directly from their domain owners.

      Scope: Governs core model contract ownership and import paths; excludes
      operational parsing, loading, resolution, graph, and retrieval behavior.

      Trade-offs: Consumers use explicit owner imports where shared vocabulary is
      needed and Inline Links for supporting documents.

      Design issues addressed: Independently evolving model domains no longer
      converge on one ownership boundary.

      Consequences: Model changes remain localized while this ordinary source
      supplies
      documentary context without re-exporting vocabulary.
    }
  }
}
