@packages/core/src/model/language.sigil from SigilLanguageModel import { LanguageModel }

component SigilConfigurationModel {
  goal {
    Define immutable configuration data exchanged between configuration parsing and
    workspace loading.
  }

  interface {
    ConfigurationModel {
      LanguageModel supplies the versioned language vocabulary. SigilConfig,
      SigilWorkspaceConfig, SigilFileDiscoveryConfig, and SigilConfigParseResult
      represent validated ConfigFile data and diagnostics.
    }
  }
}
