@packages/core/src/model/source.sigil from SigilSourceModel import { SourceModel }
@packages/core/src/model/resolution.sigil from SigilResolutionModel import { ResolutionModel }

component SigilGraphModel {
  goal {
    Define immutable component and file dependency graph data.
  }

  interface {
    GraphModel {
      SourceModel and ResolutionModel provide graph evidence. SigilGraph
      and its component, selected-Tag import, and file-dependency edges preserve
      deterministic graph output.

      Edges preserve originating owner and selection evidence without synthesizing
      expansion, directory-index, re-export, runtime-call, or consumer-to-provider
      obligation relationships. Cycles remain traversable graph relationships.
    }
  }
}
