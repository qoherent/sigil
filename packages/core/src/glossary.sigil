@spec/glossary.sigil import { SigilWorkspaceGlossary }
@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }

component SigilGlossaryEngine {
  goal {
    Parse, validate, resolve, and project reviewed workspace glossary data for
    deterministic core consumers.

    Keep vocabulary extraction, semantic judgment, approval, presentation, and
    source mutation outside core.
  }

  interface {
    GlossaryInterpretation {
      GLOSSARY_SCHEMA_VERSION identifies the supported GlossarySchema version

      parseSigilGlossary(source, filePath?) returns validated WorkspaceGlossary data
      or accumulated diagnostics
    }

    GlossaryModelProjection {
      GlossaryModelProjection adapts GlossaryModel from SigilSemanticModel into
      immutable engine exports.

      exports immutable SigilSemanticModel glossary entries, contexts, occurrences,
      projections, and parse results
    }

    ContextResolutionEngine {
      ContextResolutionEngine adapts ContextResolution into deterministic engine
      behavior.

      resolveGlossaryForFile(glossary, filePath) returns the effective entries,
      matched context, and diagnostics
    }

    TermRecognitionEngine {
      TermRecognitionEngine adapts TermRecognition into deterministic engine
      behavior.

      glossaryOccurrencesForDocument(glossary, document) returns ordered
      source-ranged occurrences
    }

    GlossaryInspection {
      glossaryProjectionForWorkspace(workspace) returns contexts, entries,
      occurrences, diagnostics, and the exact workspace.workspaceSnapshotIdentity

      glossaryContextForFiles(projection, filePaths) returns the glossary path,
      agent-visible effective entries, resolved contexts, and occurrences relevant to
      normalized selected files plus scoped diagnostics
    }
  }
}

expand SigilGlossaryEngine {
  logic {
    GlossaryInterpretation {
      Parse strict JSON and validate the complete GlossarySchema before returning
      authoritative data.

      Preserve source ranges for canonical term declarations so consumers can
      navigate to GlossaryFile.
    }

    ContextResolution {
      Resolve only normalized workspace-relative paths belonging to loaded Sigil
      documents.

      Diagnose every loaded source matched by more than one bounded context.

      Build each source's effective spelling map from workspace entries followed by
      its matched context entries.
    }

    TermRecognition {
      Scan recovered SemanticUnit prose while excluding inline code and URLs.

      Emit non-overlapping occurrences in deterministic source order.
    }

    GlossaryInspection {
      Aggregate resolved contexts, effective entries, occurrences, and glossary
      diagnostics without changing source data.

      Copy workspaceSnapshotIdentity from the supplied SigilWorkspace into every
      GlossaryProjection without recomputing it.

      Filter a workspace projection by normalized selected source paths while
      preserving deterministic source and declaration order.

      Preserve source-less diagnostics, diagnostics attached to a selected source
      path, and GlossaryFile diagnostics whose range overlaps the declaration range
      of an effective selected term. Exclude every other diagnostic.

      Exclude entries whose agentContext is false together with their occurrences
      from agent-facing scoped context.
    }
  }

  constraints {
    GlossaryInterpretation {
      SigilDiagnostics owns every glossary diagnostic emitted by this engine.

      JSON syntax failures produce SIGIL_GLOSSARY_PARSE.

      Schema and field failures produce SIGIL_GLOSSARY_INVALID.

      An invalid glossary yields no active definitions.
    }

    ContextResolution {
      Overlap produces SIGIL_GLOSSARY_CONTEXT_OVERLAP.

      Duplicate or ambiguous spellings produce SIGIL_GLOSSARY_TERM_COLLISION.
    }

    TermRecognition {
      Recognition uses source ranges already owned by recovered Sigil documents.

      Unknown prose remains ordinary text without a missing-glossary-term diagnostic.

      LiteralBlock type and body content are excluded without independently tracking
      fence state.
    }

    GlossaryInspection {
      Every projection is immutable and suitable for CLI and LSP consumption.

      Scoped context excludes terms that are neither effective in nor recognized
      within a selected source.
    }
  }

  cases {
    GlossaryInterpretation {
      Missing optional GlossaryFile returns no glossary and no diagnostic.

      Valid empty terms and contexts produce an active empty glossary.
    }

    ContextResolution {
      Context-local spellings override workspace spellings without changing other
      contexts.
    }

    TermRecognition {
      Longest-first matching emits one workspace root occurrence rather than
      overlapping workspace and workspace root occurrences.

      A glossary spelling appearing only inside a LiteralBlock produces no
      occurrence.
    }

    GlossaryInspection {
      CLI and LSP consumers receive the same resolved occurrence ranges from core.

      Selecting a component source and its related expansion sources returns their
      effective bounded-context definitions without unrelated workspace vocabulary.

      An entry excluded from agent context remains present in the complete glossary
      projection.
    }
  }
}
