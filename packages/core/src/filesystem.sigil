@packages/core/src/model/workspace.sigil from SigilWorkspaceModel import { WorkspaceModel }

component SigilFileSystem {
  goal {
    Isolate deterministic core behavior from host-specific filesystem APIs.

    Provide the asynchronous filesystem port and deterministic in-memory
    implementation used by core hosts and tests.
  }

  interface {

    ByteInput {
      readBytesFile(path) returns exact bytes or rejects with the host failure.
      Disk-backed Sigil and configuration ingress uses bytes and strict UTF-8
      decoding; readTextFile remains available for other host text.

      The deterministic in-memory implementation supports exact byte fixtures,
      including invalid UTF-8, without replacement decoding.
    }
    FileSystemPort {
      readTextFile(path) returns file text or rejects with the host failure

      exists(path) returns whether the path exists

      listFiles(root) returns files visible at or below root in stable order

      all operations are asynchronous
    }

    InMemoryFileSystem {
      InMemorySigilFileSystem(files) supplies normalized deterministic file behavior
      from a record or map
    }
  }

  logic {
    InMemoryFileSystem {
      Normalize every supplied path before storing it.

      Normalize operation paths before lookup.

      Return listed paths in stable sorted order.
    }
  }

  constraints {

    FileSystemPort {
      SigilFileSystem supplies the host-neutral filesystem access represented by
      WorkspaceModel.

      Parsing and resolution do not access host filesystems directly.

      Filesystem implementations preserve host failures rather than translating them
      into Sigil diagnostics.
    }

    InMemoryFileSystem {
      InMemorySigilFileSystem performs no host filesystem access.
    }
  }

  cases {
    FileSystemPort {
      A host filesystem and InMemorySigilFileSystem can load the same workspace
      through SigilWorkspaceLoader.
    }

    InMemoryFileSystem {
      Reading a missing in-memory file rejects with a file-not-found failure.

      Listing one root returns only normalized files at or beneath that root.
    }
  }
}
