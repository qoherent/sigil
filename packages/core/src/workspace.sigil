@packages/core/src/glossary.sigil from SigilGlossaryEngine import { GlossaryInterpretation }
@packages/core/src/parser.sigil from SigilParser import { SourceDocumentParsing }
@packages/core/src/filesystem.sigil from SigilFileSystem import { FileSystemPort, ByteInput }
@packages/core/src/diagnostics.sigil from SigilDiagnostics import { DiagnosticConstruction }
@packages/core/src/model/workspace.sigil from SigilWorkspaceModel import { WorkspaceModel }
@packages/core/config.sigil from SigilConfigurationParser import { ConfigurationParsing }
@spec/glossary.sigil from SigilWorkspaceGlossary import { GlossaryFile }
@spec/language.sigil from SigilWorkspaceConfig import { ConfigFile, WorkspaceBoundary, SourceSelection, LocalToolConfiguration }

component SigilWorkspaceLoader {
  goal {
    Discover and load one configured Sigil workspace through the filesystem port.

    Enforce configured boundaries, nested-workspace isolation, member roots, and
    source selection before relationship resolution.
  }

  interface {
    WorkspaceDiscovery {
      discoverSigilWorkspace(filesystem, options) returns WorkspaceDiscoveryResult

      options identifies a start path and may provide an explicit root or current
      directory

      WorkspaceDiscoveryResult exposes the selected root, ConfigFile path, parsed
      configuration, and diagnostics
    }

    WorkspaceLoading {
      loadSigilWorkspace(filesystem, options) returns SigilWorkspace

      SigilWorkspace adds declared member roots, loaded partial source documents, and
      accumulated diagnostics
    }

    WorkspaceSnapshotIdentity {
      each loaded SigilWorkspace exposes one 64-character lowercase
      workspaceSnapshotIdentity
    }

    GlossaryInterpretationLoading {
      GlossaryInterpretationLoading adapts GlossaryInterpretation into the workspace
      loading surface.

      loadSigilWorkspace reads and validates optional GlossaryFile into
      SigilWorkspace
    }
  }

  logic {

    SourceIngress {
      Read Sigil and configuration input as exact bytes through ByteInput. Strictly
      decode UTF-8 before parser entry, retaining original text, byte offsets, BOM,
      and newline forms in one source snapshot. Diagnose invalid bytes and retain
      independently valid loaded sources.

      String editor overlays require explicit scalar validity and source mapping
      rather than replacement decoding. A complete textual snapshot identity is
      unavailable for invalid ingress; never hash replacement text as a faithful
      input.
    }
    LocalToolConfigurationLoading {
      Apply LocalToolConfiguration by reading and validating optional LocalConfigFile
      after ConfigFile selects the workspace root, then expose the merged effective
      configuration.
    }

    WorkspaceSnapshotIdentity {
      Construct an RFC 8785 canonical object containing one record for the workspace
      config source when present, one record for the glossary source when present,
      and one record for every loaded Sigil source. Each record contains kind,
      normalized workspace-relative POSIX path, and exact decoded source text.

      Order records by normalized path then kind, serialize the object as UTF-8 JSON
      Canonicalization Scheme output under RFC 8785, compute SHA-256 under FIPS
      180-4, and encode the digest as 64 lowercase hexadecimal characters.
    }

    WorkspaceDiscovery {
      Without an explicit root, walk from the target toward filesystem root and
      select the nearest eligible ConfigFile.

      With an explicit root, require ConfigFile directly inside that root.

      Use ConfigurationParsing to validate configuration before discovering or
      parsing Sigil sources.

      Reject a nearer configured workspace when a configured parent does not exclude
      its subtree.
    }

    WorkspaceLoading {
      Derive member roots only from WorkspaceBoundary members.

      Skip excluded independent nested workspaces and diagnose included nested
      ConfigFile instances.

      Apply SourceSelection includes and then excludes to normalized
      workspace-relative paths.

      Parse selected source files in stable path order through SourceDocumentParsing.
    }

    GlossaryInterpretationLoading {
      Check for GlossaryFile after selecting the workspace boundary and before
      resolving loaded documents.

      When present, read GlossaryFile through FileSystemPort and delegate its content
      to GlossaryInterpretation.

      Accumulate glossary diagnostics while keeping invalid definitions inactive.
    }
  }

  constraints {

    WorkspaceSnapshotIdentity {
      Include LocalConfigFile source when present so a local tools override changes
      the effective workspace snapshot used by native reports and evidence.
    }

    LocalToolConfigurationLoading {
      LocalConfigFile is optional, has no workspace-discovery authority, and may
      override only the recursively merged tools configuration.

      Local configuration diagnostics prevent reliance on the effective workspace;
      the loader never repairs, rewrites, or ignores invalid local configuration.
    }

    WorkspaceSnapshotIdentity {
      Snapshot identity excludes absolute workspace root, filesystem discovery order,
      parsed objects, and diagnostics. A change to any included path or exact source
      text is computationally expected to change the identity under SHA-256 collision
      resistance, not guaranteed to do so absolutely.
    }

    WorkspaceFileAccess {
      All filesystem access uses FileSystemPort.
    }

    RecoverableResults {
      WorkspaceModel owns partial workspace results; DiagnosticConstruction supplies
      their accumulated findings.

      Configuration and source problems accumulate as diagnostics with partial
      workspace results when practical.

      Required filesystem failures propagate to the caller.
    }

    ModuleIndexFile {
      Workspace loading treats _module.sigil as an ordinary included source; it has
      no namespace, re-export, ancestry, or workspace-discovery authority.
    }

    GlossaryInterpretationLoading {
      GlossaryFile loading is independent from SourceSelection globs.

      Absence is valid while a filesystem failure reading an existing GlossaryFile
      propagates to the caller.
    }
  }

  decisions {
    DeveloperLocalToolOverrides {
      Decision: Keep workspace and language authority in tracked ConfigFile while
      loading an optional developer-local LocalConfigFile that recursively overrides
      only tools.

      Scope: Governs .sigil/local.json discovery, validation, merging, and snapshot
      identity; excludes credentials, configuration mutation, and workspace-boundary
      overrides.

      Trade-offs: Developers can select personal tool integrations and settings,
      while a local file can make two checkouts produce different tool behavior.

      Design issues addressed: A tracked host-specific tool binding forces every
      developer to share one local setup and makes personal configuration hard to
      keep out of version control.

      Discarded alternatives: Replacing ConfigFile, permitting arbitrary top-level
      overrides, and shallow replacement of the complete tools object were rejected
      because they weaken shared workspace authority or discard unrelated settings.

      Consequences: Shared repository semantics remain reproducible from ConfigFile,
      and each effective workspace snapshot records the local tools selection that
      produced it.
    }

    ContentDerivedWorkspaceSnapshotIdentity {
      Decision: Identify one loaded Sigil workspace snapshot with RFC 8785 and
      SHA-256 over its exact selected config, glossary, and Sigil source records.

      Scope: Governs association of deterministic workspace projections and
      host-supplied retrieval evidence; excludes implementation-source contents,
      absolute workspace roots, and authentication.

      Assumptions: Normalized relative paths plus exact decoded source text contain
      every loaded input that can change the resolved Sigil workspace.

      Trade-offs: Reading or hashing all selected inputs adds work during workspace
      loading, while excluding the absolute root makes identical checkouts portable.

      Design issues addressed: Object identity, modification times, and workspace
      paths cannot reliably prove that auxiliary evidence belongs to the same
      immutable semantic snapshot.

      Discarded alternatives: Random identifiers, absolute-root identity,
      modification-time identity, and hashing parsed objects were rejected as
      nonportable, unstable, or insensitive to exact loaded input.

      Consequences: Resolved workspaces and derived glossary projections share one
      reproducible association key, while implementation evidence can fail closed on
      a snapshot mismatch.

      Revisit when: Workspace loading supports non-text semantic inputs or the
      canonicalization or digest standard changes.
    }
  }

  cases {
    LocalToolConfigurationLoading {
      A valid local tools.compile override is available to native tooling while the
      same workspace retains its ConfigFile-defined sources and members.

      A malformed local configuration prevents a clean workspace load and preserves
      both configuration files unchanged.
    }

    WorkspaceSnapshotIdentity {
      Loading identical selected source records from two absolute roots produces the
      same workspaceSnapshotIdentity.

      Changing one loaded Sigil source byte is computationally expected to produce a
      different workspaceSnapshotIdentity.
    }

    WorkspaceDiscovery {
      An excluded nested workspace resolves independently.

      A nested workspace still included by a configured parent returns
      SIGIL_NESTED_CONFIG and loads no source.

      An explicit root without a direct ConfigFile returns SIGIL_CONFIG_NOT_FOUND.
    }

    WorkspaceLoading {
      A path excluded by SourceSelection is not loaded even when an include pattern
      matches.

      A filesystem read failure rejects workspace loading.
    }

    GlossaryInterpretationLoading {
      A workspace without GlossaryFile loads normally.

      A malformed GlossaryFile contributes diagnostics while loaded Sigil documents
      remain available.
    }
  }
}
