@packages/core/src/diagnostics.sigil from SigilDiagnostics import { DiagnosticConstruction }
@packages/core/src/parser.sigil from SigilParser import { SourceDocumentParsing }
@packages/core/src/model/source.sigil from SigilSourceModel import { SourceModel }
@spec/language.sigil from SigilLanguage import { FormattingStyle }

component SigilFormatter {
  goal {
    Produce a deterministic canonical representation of valid Sigil source without
    changing resolved Facets or literal content.

    Give command-line and future host consumers one reusable formatter independent
    from filesystem mutation and presentation.
  }

  interface {
    Formatting {
      formatSigilDocument(sourceDocument, source, providerContext) returns
      FormatResult; the context supplies the same resolved accessible vocabulary and
      provider snapshot used to interpret the source.

      FormatResult contains optional formatted source, changed status, and
      diagnostics

      formatted source is present only when formatting succeeds; changed is false
      when formatted source is absent
    }
  }

  logic {

    MeaningPreservation {
      Render candidates against authoritative resolved spans. Preserve local grouping
      boundaries, Inline Link destinations, labels and titles, and exact fenced
      payload content. Reparse and resolve the candidate against the identical
      provider snapshot; compare meaning signatures for Facets, definitions,
      references, links, and payloads before accepting it.

      Single-file hosts obtain required workspace/provider context before calling the
      pure formatter. Unavailable or ambiguous context fails without rewriting
      recovered invalid source as valid.
    }
    Formatting {
      Accept only source with valid recovered structure and resolved relationships,
      allowing repairable width diagnostics; reject every other error before
      formatting.

      Wrap Facet prose at 79 content characters without counting leading indentation.

      Retain one blank line between distinct prose Facets.

      Place an attached opening fence directly after its introducing prose without an
      intervening blank line.

      Preserve EmbeddedContent source lines, internal blank lines, trailing
      whitespace, and relative indentation.

      Compare the rendered source with the input to derive changed status.
    }
  }

  constraints {

    DeterministicFormatting {
      Formatting follows FormattingStyle and is deterministic and idempotent.

      Formatting requires complete valid structure and resolution with no errors
      other than repairable width diagnostics.

      Formatting does not repair unresolved imports, invalid structure, or semantic
      problems.

      Formatting removes trailing whitespace outside EmbeddedContent bodies.

      Prose wrapping occurs only at safe whitespace boundaries and preserves exact
      Tag recognition, definitions, names, references, and each Facet boundary.

      Structural lines, fence delimiters, and EmbeddedContent bodies are excluded
      from prose-width wrapping.

      Formatting does not normalize structural indentation.

      An indivisible protected span that cannot fit the normative width is retained
      with the applicable diagnostic, no formatted source, and changed false.

      Formatting preserves the input source's final-newline presence.
    }

    MutationBoundary {
      SigilFormatter performs no filesystem access and returns formatted data without
      writing source.

      Hosts own explicit selection, validation, write atomicity, output, and failure
      reporting.
    }

    DependencyDirection {
      SigilFormatter consumes SourceModel structures, parse validity from
      SourceDocumentParsing, and DiagnosticConstruction for findings.
    }
  }

  decisions {
    DeterministicFormatting {
      Decision: Canonically render valid Sigil with 79-character prose content width
      while preserving structural indentation, Facets, and literal values.

      Scope: Governs reusable in-memory source formatting; excludes source selection,
      filesystem mutation, semantic repair, and host presentation.

      Trade-offs: Indivisible long tokens remain unformatted and produce an explicit
      diagnostic.

      Design issues addressed: Host-specific formatting would drift, and line-based
      semantic identity previously prevented safe prose wrapping.

      Discarded alternatives: Independent CLI formatting, indentation-inclusive
      width, structural indentation rewriting, and formatting literal bodies were
      rejected.

      Consequences: Every host can obtain the same idempotent canonical source
      without reinterpreting language structure.
    }
  }

  cases {
    Formatting {
      Rewrapping one prose Facet preserves its normalized prose and semantic
      identity.

      Six leading spaces do not reduce the 79-character prose-content allowance.

      Introducing prose and its opening fence remain adjacent.

      A EmbeddedContent retains internal blank lines, unmatched braces, and relative
      indentation.

      Formatting canonical source returns identical bytes and changed false.

      Formatting the result of a successful formatting operation produces the same
      result.

      A source with an error other than repairable width returns no writable result.
      A source with only repairable width errors can produce a writable result only
      after the existing structural, resolution, and meaning-preservation checks.

      An unformattable indivisible token returns no formatted source, changed false,
      and SIGIL_UNFORMATTABLE_LINE.
    }
  }
}
