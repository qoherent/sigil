@spec/language.sigil import { SigilLanguage, SigilModuleIndex }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }

component SigilParser {
  goal {
    Interpret one versioned *Sigil source* into a source-faithful
    *partial document*.

    Preserve useful declarations, *Concept* headings, Facets, attached
    *literal blocks*, original *physical lines*, and *source ranges*
    whenever malformed structure permits *deterministic recovery*.
  }

  interface {
    SourceDocumentParsing {
      SourceDocumentParsing adapts SourceDocument into the *parser API*.

      parseSigilDocument(filePath, source, options) returns ParseResult

      options.sigilVersion is required and must equal
      SupportedLanguageVersion
    }

    ParseResult {
      ParseResult contains a recovered SigilDocument and
      *structural diagnostics*
    }
  }
}

expand SigilParser {
  logic {
    SourceDocument {
      Parse top-level import, component, and expand forms.

      Parse each *section* and flat Concept headings while preserving
      Concept names and ranges.

      Parse decisions as free-form expand-section content without
      requiring Concept headings or labeled fields.

      Combine adjacent prose physical lines into one blank-line-delimited
      Facet.

      Associate each Facet inside a Concept with that Concept name.

      Preserve non-empty free Facets outside Concepts.

      Parse an immediately adjacent backtick fence as a EmbeddedContent
      attached to its preceding prose Facet.

      Dedent *literal body* lines by the *opening fence* indentation
      when present while preserving additional indentation.

      Skip malformed top-level and direct form-body lines, then resume
      at the same structural level.

      Finalize EOF-unclosed Concepts, sections, components, and expands
      in nesting order while retaining their recovered content.
    }

    ComponentContract {
      Diagnose components missing goal or interface.
    }

    ModuleIndexContents {
      Diagnose a ModuleIndexFile that contains no local component.
    }

    TagIdentity {
      Accept Facets directly under every contract without requiring
      Concepts.

      Preserve mixed ungrouped and Concept-grouped Facets in source order
      without a *grouping warning*.

      Reject invalid Concept names, empty Concepts, and nested Concepts.
    }

    EmbeddedFacet {
      Reject a detached, unintroduced, invalidly typed, or unclosed
      fenced content.

      Ignore braces and apparent Sigil structure inside a literal body.
    }

    FormattingStyle {
      Report informational *SIGIL_LINE_TOO_LONG* when ordinary prose can
      be canonically wrapped below 79 content characters.

      Report error *SIGIL_UNFORMATTABLE_LINE* when one
      *indivisible token* exceeds 79 content characters.
    }

    LanguageVersion {
      Reject an unsupported configured language version before
      interpreting declarations.
    }
  }

  constraints {
    SourceDocument {
      SigilParser performs no filesystem access or workspace resolution.

      Structural recognition follows SigilLanguage SourceGrammar.

      Warnings preserve a usable partial document and do not make parsing
      fail.
    }

    SourceRecovery {
      Parser diagnostics, retained content, *resume points*, source
      ranges, and ordering follow SigilLanguage SourceRecovery without
      host-dependent synchronization.
    }

    TagIdentity {
      Concept body content remains free-form except for structural brace
      tracking.
    }

    Facet {
      A *blank line* terminates prose Facets while physical wrapping does
      not.

      Facet prose joins wrapped physical lines with one
      *normalized space* and retains the original lines and complete
      range.
    }

    EmbeddedFacet {
      *literal type* tokens match [A-Za-z][A-Za-z0-9_+.-]*.

      Literal body content creates no *semantic reference* and is exempt
      from *prose width* diagnostics.
    }

    FormattingStyle {
      Prose width counts Unicode code points after leading indentation.
    }

    DiagnosticConstruction {
      A *structural finding* is created through SigilDiagnostics.
    }
  }

  cases {
    ParseResult {
      Valid source returns recovered declarations and Facets without
      error diagnostics.

      An unclosed component returns its recoverable content with
      source-ranged structural diagnostics.
    }

    SourceDocument {
      A decisions section preserves grouped and ungrouped Facets without
      a *grouping diagnostic*.
    }

    SourceRecovery {
      An unexpected top-level line is skipped and a later valid
      declaration remains available.

      An EOF-unclosed Concept, section, and component are finalized in
      order and each receives its applicable diagnostic.
    }

    ComponentContract {
      A component missing goal or interface remains in the partial
      document with required-section diagnostics.
    }

    TagIdentity {
      An interface containing only ungrouped Facets produces no grouping
      diagnostic.

      An interface mixing ungrouped Facets and Concepts preserves both
      without requiring additional Concept names.

      A Concept with several blank-line-delimited paragraphs preserves
      one Tag identity and every Facet.

      Ungrouped Facets are valid in every contract, including interface.

      Empty and nested Concepts are invalid.
    }

    Facet {
      Two adjacent wrapped prose lines produce one Facet.

      A blank line between prose paragraphs produces two Facets.
    }

    EmbeddedFacet {
      Introducing prose immediately followed by a json fence produces
      one semantic unit with one attached EmbeddedContent.

      Blank lines and unmatched braces inside a EmbeddedContent do not
      close its Facet or enclosing Sigil forms.

      A blank line before an opening fence produces
      *SIGIL_DETACHED_LITERAL_BLOCK*.

      An opening fence without introducing prose produces
      *SIGIL_LITERAL_WITHOUT_INTRODUCTION*.

      An invalid type produces *SIGIL_INVALID_LITERAL_TYPE*.

      An unclosed fence produces *SIGIL_UNCLOSED_LITERAL_BLOCK*.
    }

    FormattingStyle {
      Six leading spaces do not reduce the 79-character prose-content
      allowance.

      An indivisible token longer than 79 content characters produces
      SIGIL_UNFORMATTABLE_LINE.
    }

    ModuleIndexContents {
      An imports-only ModuleIndexFile produces
      *SIGIL_MODULE_WITHOUT_COMPONENT*.
    }

    LanguageVersion {
      An unsupported version returns an empty partial document with
      *SIGIL_UNSUPPORTED_VERSION*.
    }
  }
}
