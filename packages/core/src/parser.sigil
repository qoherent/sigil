@spec/language.sigil from SigilLanguage import { Component, Trait, Contract, Concept, Facet, Tag, Inline Tag, Inline Link, Embedded Facet, SourceGrammar, TraitConformance }

component SigilParser {
  goal {
    Read one 0.8 Sigil source without losing its architectural structure.
  }

  interface {
    source reading {
      Reveal Component and Trait declarations, Contract sections, a Concept heading,
      Facet prose, Inline Tag and Inline Link prose, conformance, imports, and an
      Embedded Facet for later review.
    }
  }

  logic {
    source reading {
      Follow SourceGrammar while recognizing top-level Tag imports, Trait imports,
      Components, and Traits. Keep direct and Concept-grouped Facets in source order.

      Join wrapped prose into one Facet. Attach one immediately adjacent fence to its
      introducing prose as an Embedded Facet; its body remains inert to structure and
      Tag scanning.

      Retain useful authored material after malformed structure without inventing a
      declaration or meaning.
    }

    conformance reading {
      Read `is Trait1, Trait2` only on a Component. TraitConformance determines what
      that declaration means; later vocabulary resolution checks imported ownership.
    }
  }

  constraints {
    source reading {
      Reading source structure does not decide import ownership, link availability,
      or whether an architectural claim is true. Those are later concerns.
    }

    contract shape {
      Report a missing goal or interface, a duplicate contract, logic in a Trait, an
      empty or nested Concept, invalid import syntax, or a detached or unclosed fence.
    }

    inline tags and links {
      Recognize Inline Tag and Inline Link spans only in prose. Preserve physical
      wrapping inside a Facet; an Inline Tag remains on one physical line and is
      never split across asterisks or name.
    }

    fenced representations {
      Keep a fenced representation attached to its introducing Facet and literal to
      later Tag, Link, and structure reading.
    }
  }

  cases {
    source reading {
      A later valid declaration remains available after an unexpected top-level line.

      An unfinished declaration, contract, Concept, or fence remains reviewable with
      its malformed structure visible.
    }

    conformance reading {
      `component Screen is RequestSafety { ... }` records RequestSafety as
      conformance; `trait RequestSafety is Other { ... }` is invalid.
    }

    fenced representations {
      A malformed fence remains attached to the Facet that introduced it rather than
      being mistaken for ordinary prose.
    }
  }
}
