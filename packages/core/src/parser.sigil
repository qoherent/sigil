@packages/core/src/diagnostics.sigil from SigilDiagnostics import { DiagnosticConstruction }
@packages/core/src/model/source.sigil from SigilSourceModel import { SourceModel }
@spec/language.sigil from SigilLanguage import { SourceDocument, SourceRecovery, ComponentContract, TagIdentity, EmbeddedContent, FormattingStyle, LanguageVersion, ImportSemantics }

component SigilParser {
  goal {
    Interpret one Sigil 0.8.0 source snapshot into a source-faithful partial
    document.

    Preserve useful declarations, Tags, Facets, attached literal blocks, original
    physical lines, and ranges whenever malformed structure permits deterministic
    recovery.
  }

  interface {
    SourceDocumentParsing {
      SourceDocumentParsing adapts SourceDocument into the parser API.

      parseSigilDocument(filePath, source, options) returns ParseResult

      options.sigilVersion is required and must equal SupportedLanguageVersion
    }

    ParseResult {
      ParseResult contains the recovered SigilDocument and structural diagnostics
      defined by SourceModel
    }
  }

  logic {
    DocumentParsing {
      For SourceDocument, parse explicit file/provider Tag imports under
      ImportSemantics and component declarations; expand and directory-import syntax
      are invalid.

      Parse all seven contracts, flat local grouping Tags, inline Tag definitions,
      Inline Links, and physical source spans.

      Parse decisions as free-form component-section content without requiring
      grouping Tags or labeled fields.

      Combine adjacent prose physical lines into one blank-line-delimited Facet.

      Associate each Facet inside a Tag block with that identifier.

      Preserve non-empty free Facets outside Tag blocks.

      Parse an immediately adjacent backtick fence as a EmbeddedContent attached to
      its preceding prose Facet.

      Dedent literal body lines by the opening-fence indentation when present while
      preserving additional indentation.

      Recover malformed structure at the normative boundary for its kind, preserving
      invalid evidence. In particular, retain an unknown contract as an invalid
      section and skip its balanced body; do not reinterpret nested content as
      component contracts. Preserve independent later declarations.

      Finalize EOF-unclosed grouping blocks, sections, and components in nesting
      order, preserving recovered content and validity/completeness markers.
    }

    RequiredContractParsing {
      For ComponentContract, diagnose missing, empty, or repeated required sections
      and repeated optional sections under the normative recovery policy.
    }

    TagSyntaxParsing {
      For TagIdentity, accept Facets directly under every contract without requiring
      Tag blocks.

      Preserve mixed ungrouped and Tag-grouped Facets in source order without a
      grouping warning.

      Reject invalid exact Tag names, empty grouping blocks, and nested grouping
      blocks under the normative recovery policy.
    }

    EmbeddedFacet {
      Reject a detached, unintroduced, invalidly typed, or unclosed fenced content.

      Ignore braces and apparent Sigil structure inside literal bodies.
    }

    WidthChecking {
      For FormattingStyle, apply the normative width rules and diagnostic catalog;
      repairable prose width findings retain usable source.

      Report the normative unformattable-width error when an indivisible protected
      span cannot satisfy the content limit.
    }

    VersionChecking {
      Under LanguageVersion, reject an unsupported configured language version before
      interpreting declarations.
    }
  }

  constraints {

    PhysicalSource {
      Scan inline content on original physical lines before display joining. Protect
      complete links and images, including labels and titles, from Tag and brace
      scanning. Keep their ranges and destinations, and scan Embedded Facet
      introducing prose normally.

      Retain strict UTF-8 ingress validity, exact bytes/text, BOM and CR/LF/CRLF, and
      authoritative byte, scalar, and UTF-16 coordinate mappings. Editor string
      overlays require scalar validation. The shared scanner records structural
      occurrences; collective resolution owns vocabulary and bare-reference matching.
    }

    DocumentParsing {
      For SourceDocument, SigilParser performs no filesystem access or workspace
      resolution.

      Structural recognition follows [the normative
      reference](../../../spec/sigil-reference.md) and
      [grammar](../../../spec/sigil.ebnf); [migration
      guidance](../../../spec/migrating-to-0.8.md) explains the removed forms.

      Warnings preserve a usable partial document and do not make parsing fail.
    }

    ParserRecovery {
      Under SourceRecovery, parser diagnostics, retained content, resume points,
      source ranges, and ordering follow SigilLanguage SourceRecovery without
      host-dependent synchronization.
    }

    TagSyntaxParsing {
      For TagIdentity, tag body content remains free-form except for structural brace
      tracking.
    }

    Facet {
      Blank lines terminate prose Facets while physical wrapping does not.

      Facet prose joins wrapped physical lines with one normalized space and retains
      the original lines and complete range.
    }

    EmbeddedFacet {
      Literal type tokens match [A-Za-z][A-Za-z0-9_+.-]*.

      Literal bodies create no semantic references and are exempt from prose-width
      diagnostics.
    }

    WidthChecking {
      For FormattingStyle, prose width counts Unicode scalars after leading
      indentation, with normative exclusions for structural lines, payloads, and link
      destinations.
    }

    ParserDiagnostics {
      Structural findings use DiagnosticConstruction from SigilDiagnostics.
    }
  }

  cases {
    ParseResult {
      Valid source returns recovered declarations and Facets without error
      diagnostics.

      An unclosed component returns its recoverable content with a source-ranged
      structural diagnostic.
    }

    DocumentParsing {
      For SourceDocument, a decisions section preserves grouped and ungrouped Facets
      without a grouping diagnostic.
    }

    ParserRecovery {
      Under SourceRecovery, an unexpected top-level line is skipped and a later valid
      declaration remains available.

      An EOF-unclosed Tag, section, and component are finalized in order and each
      receives its applicable diagnostic.
    }

    RequiredContractParsing {
      For ComponentContract, a component missing goal or interface remains in the
      partial document with required-section diagnostics.
    }

    TagSyntaxParsing {
      For TagIdentity, an interface containing only ungrouped Facets produces no
      grouping diagnostic.

      An interface mixing ungrouped Facets and Tag blocks preserves both without
      requiring additional identifiers.

      A Tag block with several blank-line-delimited paragraphs preserves one identity
      and every Facet.

      Ungrouped Facets are valid in every contract, including interface.

      Empty and nested Tag blocks are invalid.
    }

    Facet {
      Two adjacent wrapped prose lines produce one Facet.

      A blank line between prose paragraphs produces two Facets.
    }

    EmbeddedFacet {
      Introducing prose immediately followed by a json fence produces one semantic
      unit with one attached EmbeddedContent.

      Blank lines and unmatched braces inside a EmbeddedContent do not close its
      Facet or enclosing Sigil forms.

      A blank line before an opening fence produces SIGIL_DETACHED_LITERAL_BLOCK.

      An opening fence without introducing prose produces
      SIGIL_LITERAL_WITHOUT_INTRODUCTION.

      An invalid type produces SIGIL_INVALID_LITERAL_TYPE.

      An unclosed fence produces SIGIL_UNCLOSED_LITERAL_BLOCK.
    }

    WidthChecking {
      For FormattingStyle, six leading spaces do not reduce the 79-character
      prose-content allowance.

      An indivisible token longer than 79 content characters produces
      SIGIL_UNFORMATTABLE_LINE.
    }

    VersionChecking {
      Under LanguageVersion, an unsupported version returns an empty partial document
      with SIGIL_UNSUPPORTED_VERSION.
    }
  }
}
