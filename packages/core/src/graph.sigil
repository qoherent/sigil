@spec/language.sigil import { SigilModuleIndex }
@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/resolver.sigil import { SigilResolver }

component SigilGraphBuilder {
  goal {
    Convert resolved Sigil relationships into deterministic structural graph data.

    Keep graph construction independent from parsing, filesystem access,
    diagnostics policy, and presentation.
  }

  interface {
    GraphConstruction {
      buildSigilGraph(resolution) returns SigilGraph
    }

    GraphData {
      SigilGraph exposes component nodes, file dependency edges, imported-component
      edges, and component-expansion edges
    }

    StronglyConnectedGroups {
      stronglyConnectedComponentGroups(graph) returns immutable ordered arrays of
      existing component-node identities, including singleton groups
    }
  }
}

expand SigilGraphBuilder {
  logic {
    GraphConstruction {
      Create one component node for each resolved component.

      Create file dependency edges to immediate imported sources or ModuleIndexFile.

      Create imported-component edges to original component declarations.

      Create component-expansion edges for every collected expand.

      Preserve deterministic workspace and declaration ordering.
    }

    StronglyConnectedGroups {
      Apply Tarjan's strongly connected component algorithm to component nodes and
      imported-component edges.

      Visit component nodes in SigilGraph component-node order and each node's
      outgoing imported-component edges in SigilGraph edge order. Compare identity
      through exact component-node identity rather than component name alone.

      Order members within each maximal group by component-node order. After all
      groups are complete, order groups by the component-node order of their first
      member. Include an acyclic node as one singleton group and represent a
      self-import as a singleton group whose node has an explicit self edge.
    }
  }

  constraints {
    GraphConstruction {
      Graph construction consumes SigilResolver relationship data.

      Graph construction performs no filesystem access, source parsing, or
      relationship reinterpretation.

      Graph construction adds no diagnostics.
    }

    GraphData {
      SigilSemanticModel owns the graph data shapes built here.

      Graph edges represent resolved structural relationships and do not claim
      behavioral compliance.
    }

    StronglyConnectedGroups {
      SCC derivation is deterministic, read-only, and adds no graph edges or
      diagnostics.

      Every component node occurs in exactly one maximal group. Group results expose
      only identities already owned by SigilGraph and introduce no second graph-data
      model.
    }
  }

  decisions {
    DeterministicSCCProjection {
      Decision: Derive maximal imported-component strongly connected groups with
      ordered Tarjan traversal and return existing component-node identities.

      Scope: Governs structural cycle projection; excludes cycle diagnostics,
      retrieval relevance, and presentation.

      Trade-offs: Traversal order is compatibility-significant even though maximal
      SCC membership is mathematically order-independent.

      Design issues addressed: Retrieval and compiler scheduling need one shared
      cycle owner instead of independently implementing graph traversal.

      Discarded alternatives: Consumer-owned DFS, discovery-order Tarjan traversal,
      and a second SCC node model were rejected as duplicative or unstable.

      Consequences: Core consumers share identical maximal groups and retain graph
      node identity without introducing new edges or diagnostics.
    }
  }

  cases {
    GraphData {
      A resolved import produces a file dependency edge and an imported-component
      edge.

      A directory import points its file edge to ModuleIndexFile and its component
      edge to the original declaration.

      An unresolved imported name produces no imported-component edge.

      Two matching expands produce two component-expansion edges.
    }

    StronglyConnectedGroups {
      A three-node cycle returns one group ordered by component-node order.

      Two independent acyclic nodes return two singleton groups ordered by their
      first member.

      A self-import remains a singleton group distinguishable by its graph self edge.
    }
  }
}
