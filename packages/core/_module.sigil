@packages/core/src/design-input.sigil from SigilDesignInput import { ResolvedDesignInput }
@packages/core/src/context-retrieval.sigil from SigilContextRetrieval import { PurposeRetrievalRequest, PurposeRetrievalResult }
@packages/core/src/compilation-boundary.sigil from SigilCompilationBoundary import { BoundarySelection, loaded workspace }
@packages/core/src/implementation-ownership.sigil from SigilImplementationOwnership import { OwnedImplementationLookup }
@packages/core/src/projections.sigil from SigilProjections import { ContractProjection, resolved workspace }
@packages/core/src/pipeline.sigil from SigilWorkspaceResolutionPipeline import { WorkspaceResolution }
@packages/core/src/graph.sigil from SigilGraphBuilder import { GraphConstruction }
@packages/core/src/resolver.sigil from SigilResolver import { RelationshipResolution }
@packages/core/src/workspace.sigil from SigilWorkspaceLoader import { WorkspaceLoading }
@packages/core/src/path.sigil from SigilPath import { PathOperations }
@packages/core/src/formatter.sigil from SigilFormatter import { Formatting }
@packages/core/src/glossary.sigil from SigilGlossaryEngine import { GlossaryInterpretation }
@packages/core/src/parser.sigil from SigilParser import { SourceDocumentParsing }
@packages/core/src/filesystem.sigil from SigilFileSystem import { FileSystemPort }
@packages/core/src/diagnostics.sigil from SigilDiagnostics import { DiagnosticConstruction }
@packages/core/src/model/_module.sigil from SigilSemanticModel import { DomainModelAssembly }
@packages/core/config.sigil from SigilConfigurationParser import { ConfigurationParsing }
@spec/language.sigil from SigilLanguage import { SourceDocument, resolution }
@spec/language.sigil from SigilWorkspaceConfig import { host integrations }

component SigilCore {
  goal {
    Provide the *deterministic language implementation* shared by Sigil
    command-line,
    language-server, editor, and agent integrations.

    Compose *source interpretation*, configuration, workspace loading, glossary
    interpretation, relationship resolution, graph construction, projections, and
    diagnostics without owning host interaction or semantic judgment.
  }

  constraints {

    CorePackageBoundary {
      This ordinary source is a *concise documentary package-boundary summary*, with
      no
      language namespace assembly or re-export.

      Operational parsing, formatting, path, configuration, workspace, resolution,
      graph, glossary, projection, ownership, and retrieval behavior remains owned by
      its selected cohesive provider component.
    }

    PackageVersionOwnership {
      packages/core/deno.json owns the @qoherent/sigil-core *artifact version*.

      The package contract does not duplicate its *manifest-owned version literal*.
    }

    DeterministicCore {
      Core computes structural facts and performs no model-assisted semantic
      *judgment*.

      Core does not own *CLI arguments*, LSP transport, editor APIs, agent-host
      behavior, approval decisions, or user-interface presentation.
    }

    CoreDependencies {
      SigilSemanticModel, SigilDiagnostics, and SigilFileSystem are
      the foundation contracts.

      SigilConfigurationParser and SigilParser consume the *foundation contracts*.

      SigilFormatter consumes parser output and foundation contracts.

      SigilPath is a filesystem-independent foundation contract consumed by core and
      host integrations.

      GlossaryInterpretation consumes the DomainModelAssembly and
      DiagnosticConstruction contracts.

      WorkspaceLoading composes configuration, filesystem, parser, and glossary
      contracts into a loaded workspace.

      SigilResolver consumes the loaded workspace, and SigilGraphBuilder consumes
      resolver output.

      ContractProjection consumes resolver and graph output.

      WorkspaceResolution composes resolver, graph, and glossary output.

      SigilImplementationOwnership consumes a resolved workspace and supplied
      implementation evidence.

      PurposeRetrievalResult carries graph, glossary, and ownership evidence.

      SigilCompilationBoundary consumes the *resolved Tag-selection* and consumer-use
      graph to resolve a compilation seed into a covering boundary.

      Core operational components depend on their focused providers; this summary
      adds no language namespace or *runtime dependency*.

      Host integrations consume core semantics instead of implementing independent
      *Sigil parsers*, workspace rules, resolvers, or Tag interpretation.
    }
  }

  cases {
    DeterministicCore {
      CLI and LSP resolving the same loaded workspace return the same workspace
      snapshot identity, resolved components, graph edges, glossary projection, and
      ordered diagnostics.
    }
  }

  interface {
    CorePackage {
      SigilCore exports the deterministic APIs that implement SourceDocument through
      SourceDocumentParsing, ConfigurationParsing, DomainModelAssembly,
      DiagnosticConstruction, FileSystemPort, Formatting, PathOperations,
      WorkspaceLoading, RelationshipResolution, GraphConstruction,
      WorkspaceResolution, ContractProjection, GlossaryInterpretation,
      OwnedImplementationLookup, BoundarySelection, PurposeRetrievalRequest, and
      ResolvedDesignInput. Their operations and data remain owned by the selected
      provider components; package exports do not re-export Sigil Tag identities.

      Keep ResolvedDesignInput in the core package as the TypeScript
      side of the shared conformance corpus; sigilc reads sources itself. It never
      invokes sigilc, reconstructs semantic assertions or presents verdicts.

      hosts consume those *cohesive contracts* without reimplementing source
      interpretation, workspace rules, relationship resolution, or projections
    }
    Exposes manifest-owned version literal to direct consumers.

    Exposes source interpretation to direct consumers.

  }

  decisions {
    DeterministicCore {
      Decision: Centralize reproducible Sigil semantics in one typed shared core and
      keep *host interaction* and model-assisted judgment outside it.

      Scope: Governs parsing, configuration, workspace loading, resolution, graphs,
      diagnostics, and primitive projections; excludes transport, presentation,
      elicitation, and approval.

      Trade-offs: Hosts must consume core projections and *semantic readiness*
      remains
      a separate workflow responsibility.

      Discarded alternatives: Host-specific parsers and *direct model access* from
      core
      were rejected.

      Consequences: *Compatible hosts* derive structural facts from the same
      implementation boundary.

      Revisit when: A required shared semantic fact cannot be represented without
      *host coupling*.
    }
  }
}
