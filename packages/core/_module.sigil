@spec/language.sigil import { SigilLanguage }
@packages/core/config.sigil import { SigilConfigurationParser }
@packages/core/src/model import { SigilSemanticModel }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }
@packages/core/src/filesystem.sigil import { SigilFileSystem }
@packages/core/src/parser.sigil import { SigilParser }
@packages/core/src/glossary.sigil import { SigilGlossaryEngine }
@packages/core/src/formatter.sigil import { SigilFormatter }
@packages/core/src/path.sigil import { SigilPath }
@packages/core/src/workspace.sigil import { SigilWorkspaceLoader }
@packages/core/src/resolver.sigil import { SigilResolver }
@packages/core/src/graph.sigil import { SigilGraphBuilder }
@packages/core/src/pipeline.sigil import { SigilWorkspaceResolutionPipeline }
@packages/core/src/projections.sigil import { SigilProjections }
@packages/core/src/implementation-ownership.sigil import { SigilImplementationOwnership }
@packages/core/src/compilation-boundary.sigil import { SigilCompilationBoundary }
@packages/core/src/context-retrieval.sigil import { SigilContextRetrieval }

component SigilCore {
  goal {
    Provide the deterministic semantic engine shared by Sigil command-line,
    language-server, editor, and agent integrations.

    Compose source interpretation, configuration, workspace loading, glossary
    interpretation, relationship resolution, graph construction, projections, and
    diagnostics without owning host interaction or semantic judgment.
  }

  interface {
    CorePackage {
      SigilCore exports the deterministic Sigil language, configuration, workspace,
      resolution, graph, glossary, projection, ownership, retrieval, and immutable
      semantic-model contracts assembled from SigilLanguage,
      SigilConfigurationParser, SigilSemanticModel, SigilDiagnostics,
      SigilFileSystem, SigilParser, SigilFormatter, SigilPath, SigilWorkspaceLoader,
      SigilResolver, SigilGraphBuilder, SigilWorkspaceResolutionPipeline,
      SigilProjections, SigilGlossaryEngine, SigilImplementationOwnership, and
      SigilContextRetrieval

      hosts consume those cohesive contracts without reimplementing source
      interpretation, workspace rules, relationship resolution, or projections
    }
  }
}

expand SigilCore {
  constraints {
    CorePackageBoundary {
      The module index is a concise boundary summary and namespace-assembly surface.

      Operational parsing, formatting, path, configuration, workspace, resolution,
      graph, glossary, projection, ownership, and retrieval behavior remains owned by
      its imported cohesive component.
    }

    PackageVersionOwnership {
      packages/core/deno.json owns the @qoherent/sigil-core artifact version.

      The package contract does not duplicate its manifest-owned version literal.
    }

    DeterministicCore {
      Core computes structural facts and performs no model-assisted semantic
      judgment.

      Core does not own CLI arguments, LSP transport, editor APIs, agent-host
      behavior, approval decisions, or user-interface presentation.
    }

    DependencyDirection {
      SigilSemanticModel, SigilDiagnostics, and SigilFileSystem are foundation
      contracts.

      SigilConfigurationParser and SigilParser consume the foundation contracts.

      SigilFormatter consumes parser output and foundation contracts.

      SigilPath is a filesystem-independent foundation contract consumed by core and
      host integrations.

      SigilGlossaryEngine consumes model and diagnostic contracts.

      SigilWorkspaceLoader composes configuration, filesystem, parser, and glossary
      contracts into a loaded workspace.

      SigilResolver consumes the loaded workspace, and SigilGraphBuilder consumes
      resolver output.

      SigilProjections consumes resolver and graph output.

      SigilWorkspaceResolutionPipeline composes resolver, graph, and glossary output.

      SigilImplementationOwnership consumes a resolved workspace and supplied
      implementation evidence.

      SigilContextRetrieval consumes graph, glossary, and ownership evidence.

      SigilCompilationBoundary consumes the resolved import and expand graph to
      resolve a compilation seed into a covering boundary.

      No core operational component imports SigilCore; the module index only
      assembles the public namespace.

      Host integrations consume core semantics instead of implementing independent
      Sigil parsers, workspace rules, resolvers, or concept interpretation.
    }

  }

  decisions {
    DeterministicCore {
      Decision: Centralize reproducible Sigil semantics in one typed shared core and
      keep host interaction and model-assisted judgment outside it.

      Scope: Governs parsing, configuration, workspace loading, resolution, graphs,
      diagnostics, and primitive projections; excludes transport, presentation,
      elicitation, and approval.

      Trade-offs: Hosts must consume core projections and semantic readiness remains
      a separate workflow responsibility.

      Discarded alternatives: Host-specific parsers and direct model access from core
      were rejected.

      Consequences: Compatible hosts derive structural facts from the same
      implementation boundary.

      Revisit when: A required shared semantic fact cannot be represented without
      host coupling.
    }
  }

  cases {
    DeterministicCore {
      CLI and LSP resolving the same loaded workspace return the same workspace
      snapshot identity, resolved components, graph edges, glossary projection, and
      ordered diagnostics.
    }
  }
}
