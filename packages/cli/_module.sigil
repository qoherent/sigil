@spec/language.sigil import { SigilLanguage, SigilWorkspaceConfig }
@packages/core import { SigilCore, SigilContextRetrieval }
@packages/cli/src/installer.sigil import { SkillInstaller }
@packages/cli/src/retrieval-markdown.sigil import { SigilRetrievalMarkdown }

component SigilCli {
  goal {
    Expose deterministic Sigil language and workspace operations to agents, CI,
    scripts, debugging and review workflows through a non-interactive command line.

    Use SigilCore for language operations and structural Design export. Keep
    skill installation separate. Models and operators invoke sigilc directly
    for semantic compilation; this language CLI owns no compiler facade.
  }

  interface {
    DesignExport {
      sigil export design [path] [--root workspace] [--pretty]

      Use the core loadDesignInput operation to export the complete discovered
      workspace as its closed *structural JSON bundle*. A path locates a workspace;
      native sigilc scope selects focused *Design roots* afterward. Write the raw
      bundle to stdout without a *CLI envelope*, *semantic lowering*,
      *display-path substitution* or changes to *captured text*. Retain diagnostics
      and return the ordinary *language diagnostic exit code*. Runtime failures
      produce no partial bundle. Support only JSON; reject quiet suppression. Never
      invoke sigilc, a model, a profile or the removed *semantic compiler*.
    }

    SourceDiscovery {
      Host listing skips git metadata and symlinks. Within a
      *Sigil metadata directory*, list only config.json, local.json and glossary.json
      so nested workspace configuration remains visible while *generated source* is
      excluded. Use core *path normalization* and joining directly. Do not depend on
      an obsolete *compiler artifact taxonomy* or retain *duplicate path algorithms*.
    }

    RemovedSemanticCommands {
      Remove semantic, compile, doctor and obsolete config authoring commands, their
      handlers, compiler adapter dispatch and tests dedicated to beams, accepted
      worlds, managed views, handoffs, receipts and TS7 verification. An invocation
      of a *removed command* returns ordinary *invalid usage*. No
      *compatibility dispatch* or *renamed legacy command* survives. Export
      structural Design through core; the model or operator uses native sigilc
      directly. Retain normal configuration discovery/validation, init and
      *version metadata*. No JSONL *compiler event stream*, *compiler history* or
      *compiler subprocess* belongs in this language *command path*.
    }

    CliInvocation {
      sigil --help

      sigil <command-path> --help

      A command path consists of a command followed by zero or more
      *nested subcommands*.

      Empty, unknown, incomplete, or invalid invocations report the specific usage
      problem together with help for the longest recognized command path.

      sigil --version
    }

    SkillCatalogCommand {
      SkillCatalogCommand adapts SkillCatalog into a CLI *command surface*.

      sigil skill list
    }

    SkillInstallationCommand {
      SkillInstallationCommand adapts SkillInstallation into a CLI command surface.

      sigil skill install [--project] [--agent codex|claude|opencode|pi|all]
    }

    WorkspaceInitialization {
      sigil init [path] [--name value] [--include glob ...] [--exclude glob ...]

      init writes an empty tools object. It never seeds *model providers*,
      *evaluator profiles*, *compilation stages* or *runtime configuration*.
    }

    WorkspaceInspection {
      sigil version [path]

      sigil parse file

      sigil check [path]

      sigil graph [path]

      sigil context [path] (--component name | --file file) [--include-dependents]

      sigil render [path]

      check reports resolved workspace diagnostics together with deterministic
      *ownership-annotation diagnostics* from *supported implementation sources*

      context reports a *scoped glossary projection* for the selected component
      or file and its related sources

      when --file selects a source containing one or more expands, context selects
      each parent component represented by those expands together with components
      declared directly in that source

      context automatically reports *public contracts* and *durable decisions* from
      direct dependencies

      context with --include-dependents reports direct importing files for the
      selected component and contextual public contracts declared in those files
      without proving *component-level dependency*
    }

    PurposeContextRetrieval {
      sigil retrieve [path] (--component name | --file file) --purpose
      semantic|architecture|implementation

      retrieve supports --format json and --format markdown; JSON is the default

      retrieve returns the complete *PurposeRetrievalResult* produced by
      SigilContextRetrieval without changing membership, ordering, explanations,
      diagnostics, context, or fingerprint
    }

    MarkdownOutput {
      sigil render [path] --format markdown

      sigil context [path] (--component name | --file file) --format markdown

      sigil retrieve [path] (--component name | --file file) --purpose
      semantic|architecture|implementation --format markdown

      render markdown reports *workspace metadata*, component contracts, collected
      expansions, and diagnostics as deterministic Markdown.

      context markdown reports selected component contracts, selected expansions,
      *Tag scope* details, direct dependency contracts and *dependency decisions*,
      owned implementation projections, *related files*, *glossary context*, and
      diagnostics as deterministic Markdown.

      retrieve Markdown delegates component-first retrieval presentation to
      SigilRetrievalMarkdown.
    }

    SourceFormattingCommand {
      SourceFormattingCommand adapts SourceFormatting into a CLI command surface.

      sigil fmt [path]

      sigil fmt [path] --check

      a .sigil file selects that file while a directory selects included .sigil
      sources beneath that path through ConfigFile *source-selection rules*
    }

    OwnershipContext {
      context reports one *owned-implementation projection* for each selected
      component

      Each projection contains normalized owned implementation targets and
      *ownership diagnostics* from supported workspace implementation sources.

      Each owned implementation target preserves its relation, artifact kind, file
      path, selected sections, and optional symbol identity.

      When implementation-source enumeration fails after *workspace resolution*,
      context returns resolved contracts and one empty ownership projection per
      selected component with a warning diagnostic.
    }

    OwnershipDiagnostics {
      check scans supported implementation sources and reports malformed, detached,
      unknown-target, and unresolved-section ownership diagnostics.
    }

    GlossaryInspectionCommand {
      GlossaryInspectionCommand adapts GlossaryInspectionFacade into a CLI command
      surface.

      sigil glossary [path]

      reports authoritative entries, resolved contexts, source occurrences, and
      glossary diagnostics
    }

    StructuredOutput {
      *structured output* supports --format json and --pretty

      markdown output supports --format markdown for workspace inspection, purpose
      retrieval without changing *JSON result shapes*

      commands that produce no required stdout support --quiet
    }

    CheckSourceLocations {
      sigil check [path] --format text supports an opt-in --show-locations flag
    }

    WorkspaceMutationBoundary {
      workspace inspection commands do not modify .sigil source

      init may create the .sigil directory, a missing ConfigFile, and a missing
      seeded GlossaryFile but no .sigil source

      fmt explicitly rewrites only selected valid .sigil source while fmt --check
      remains read-only
    }

  }
}

expand SigilCli {
  logic {
    CliInvocation {
      Top-level --help lists supported commands and global options without
      *workspace discovery*.

      --help following any recognized command path reports usage, operands, options,
      and immediate subcommands scoped to that path before ordinary validation or
      execution.

      Usage failures select help for the longest recognized command path and report
      it together with the specific problem.

      --version prints the *CLI artifact version* from packages/cli/deno.json without
      workspace discovery.
    }

    SkillCatalog {
      skill list delegates bundled-skill discovery to SkillInstaller and reports
      valid skills with supported installation targets without changing the
      filesystem.
    }

    SkillInstallation {
      skill install delegates installation to SkillInstaller.

      skill install uses global scope and all supported agents by default.

      --project selects the current repository and --agent limits installation to one
      named agent.
    }

    WorkspaceInitialization {
      init writes ConfigFile with the supported language version and refuses to
      overwrite an existing file.

      init defaults workspace.name to the target-directory basename and
      workspace.members to an empty array.

      init applies SigilWorkspaceConfig's default SourceSelection values and writes
      an empty tools object.

      init creates a missing GlossaryFile containing only the
      *decision-record field* labels.

      The seeded entries are Decision:, Scope:, Assumptions:, Trade-offs:, Design
      issues addressed:, Discarded alternatives:, Consequences:, and Revisit when:.

      Every seeded entry sets agentContext to false and the glossary has no
      *bounded contexts*.

      init preserves an existing GlossaryFile instead of merging, replacing, or
      normalizing it.
    }

    WorkspaceInspection {
      version reports CLI and core artifact versions and the configured
      LanguageVersion when available.

      parse discovers and validates configuration before interpreting the selected
      source.

      check, graph, context, and render delegate workspace semantics to SigilCore.

      context obtains effective terminology for selected and related files from
      SigilCore.

      context resolves a file selection to components declared in that source and
      parent components represented by expands in that source, deduplicated by exact
      *component identity*

      check reports core warnings, hints, and errors without reinterpreting them.

      Workspace source discovery skips symlink entries so installed skills cannot
      re-enter the workspace as duplicate Sigil sources.

      A configuration error prevents source loading and parse JSON reports document:
      null with diagnostics.
    }

    PurposeContextRetrieval {
      retrieve resolves the workspace and exact target through SigilCore and
      loads the complete workspace *GlossaryProjection*. SigilContextRetrieval
      derives its scoped *GlossaryContextProjection* after selecting Sigil
      evidence paths. The CLI enumerates supported implementation sources once
      only for implementation purpose and otherwise supplies null
      *implementation evidence*.

      retrieve passes those complete inputs and the requested purpose to
      SigilContextRetrieval and performs no independent graph traversal, evidence
      ranking, membership filtering, or context aggregation.

      Legacy context remains a *compatibility projection* with its existing
      result shape. It does not claim the schema, policy version, fingerprint, or
      authoritative membership of a PurposeRetrievalResult.

      JSON serializes the structured result. Retrieval Markdown delegates its
      projection structure and rendering policy to SigilRetrievalMarkdown.

      JSON preserves the complete PurposeRetrievalResult v1. A projection-aware JSON
      representation identifies sigil-retrieval-projection/v1 without changing raw
      retrieval membership, evidence ordering, or the raw fingerprint input.
    }

    SourceFormatting {
      fmt resolves selected sources through ConfigFile and delegates in-memory
      canonical rendering to SigilCore.

      fmt parses and validates every selected source before any write.

      fmt writes only selected .sigil files whose canonical source differs.

      fmt --check compares canonical source without writing.

      fmt reports formatted, unchanged, noncanonical, and failed sources.
    }

    MarkdownOutput {
      render markdown delegates component contract projection to SigilCore and
      renders the resolved expansion projection already carried by each rendered
      component.

      context command assembly derives selected contracts, expansions, Tag scopes,
      and dependency contexts from each exact selected component
      identity.

      context markdown renders only selected contracts, expansions, Tag scopes,
      dependency contexts, and ownership projections that match the
      selected component identity.

      dependency decisions are attached to a dependency contract only when the
      dependency name is unambiguous in the direct dependency context.

      ambiguous dependency decisions remain visible as other dependency decisions
      rather than being attached to every same-named dependency contract.
    }

    OwnershipContext {
      context loads supported implementation sources once and delegates ownership
      lookup for each selected component to SigilCore.

      context continues scanning when a discovered implementation source disappears
      or cannot be read.

      context converts a failed optional implementation-source enumeration into
      SIGIL_IMPLEMENTATION_SOURCE_DISCOVERY, supplies no ownership sources, and
      continues building structured context.
    }

    OwnershipDiagnostics {
      check delegates workspace-wide ownership-diagnostic scanning to SigilCore and
      preserves resolved workspace diagnostics and optional source-discovery
      warnings.
    }

    GlossaryInspection {
      glossary delegates loading, context resolution, occurrence matching, and
      diagnostics to SigilCore.
    }

    CheckSourceLocations {
      --show-locations renders each diagnostic's available file path and, when a
      range is present, its one-based line and column before the message.

      Only check accepts --show-locations; other commands reject it as an unsupported
      option.
    }

  }

  constraints {
    ArtifactVersionOwnership {
      packages/cli/deno.json owns the CLI artifact version.

      The CLI Sigil contract does not duplicate its manifest-owned version literal.
    }

    StructuredOutput {
      Workspace-dependent inspection JSON includes workspaceRoot, configPath,
      sigilVersion, and workspaceName. Design export instead emits the exact
      closed core bundle, with no CLI envelope.

      Deterministic CLI commands are non-interactive and reproducible from the same
      inputs.

      context JSON output includes glossaryContext with the glossary path, resolved
      bounded contexts, canonical terms, definitions, aliases, and relevant
      occurrences.

      context JSON labels dependency decisions as agent rationale outside the
      dependent-facing contract.

      context JSON omits dependent context fields unless --include-dependents is
      requested.

      context dependent context is file-level importing context derived from resolved
      imported-component graph edges.

      glossary JSON output includes workspace metadata, glossary path, schema
      version, contexts, terms, occurrences, and diagnostics.
    }

    CheckSourceLocations {
      --show-locations affects only check text output; default text output and every
      JSON and Markdown result are unchanged when the flag is absent.

      Rendered locations reuse the diagnostic file path and range already normalized
      for CLI output, and one-based line and column agree with the diagnostic model;
      no new coordinates are computed.
    }

    MarkdownOutput {
      Markdown rendering does not change command JSON behavior.

      Markdown rendering preserves component identity with component name and file
      path when an exact identity is present in the command result.

      Markdown rendering does not use name-only fallback to associate contracts,
      dependency contexts, dependency decisions, expansions, Tag scopes, or
      ownership projections with a selected component when duplicate component names
      can exist.

      Markdown diagnostics use the stable human diagnostic text form of severity,
      code, and message.
    }

    OwnershipContext {
      context JSON includes ownedImplementationProjections.

      context JSON preserves every owned implementation target's selected sections.

      Ownership diagnostics are also included in the command diagnostics.

      Implementation-source enumeration recovery applies only after required
      workspace resolution succeeds.

      SIGIL_IMPLEMENTATION_SOURCE_DISCOVERY has warning severity and does not change
      the successful exit status.
    }

    WorkspaceMutationBoundary {
      parse, version, check, graph, context, render, glossary, and fmt --check do not
      modify .sigil source.

      init creates only the .sigil directory, a missing ConfigFile, and a missing
      seeded GlossaryFile.

      fmt explicitly mutates only selected .sigil source and never formats ConfigFile
      or GlossaryFile.

      fmt performs no write when any selected source has an error diagnostic or when
      canonical rendering fails.

      Skill commands do not require or modify ConfigFile.

      glossary is a read-only workspace inspection command.
    }

    SourceFormatting {
      fmt is deterministic and non-interactive.

      fmt supports --format json, --pretty, and --quiet.

      fmt preserves the core formatter result without repairing semantic or
      resolution diagnostics.

      fmt --check exits with code 1 when any selected source is noncanonical or has a
      formatting error.

      successful fmt and canonical fmt --check exit with code 0.

      invalid fmt usage exits with code 2 and host or filesystem failure exits with
      code 3.
    }

    SkillInstallation {
      Skill installation never overwrites unmanaged files, directories, or links.
    }

    ExitStatus {
      Explicit help for any recognized command path exits with code 0.

      Empty, unknown, incomplete, or invalid usage exits with code 2, writes the
      problem and contextually relevant help to stderr, and leaves stdout empty.

      *Exit code 0* means success or warnings only.

      *Exit code 1* means configuration or Sigil error
      diagnostics.

      *Exit code 2* means invalid command usage.

      *Exit code 3* means a host or runtime failure.
    }

  }

  decisions {

    CliInvocation {
      Decision: Resolve explicit help and usage-error help against the longest
      recognized path in the command tree.

      Scope: Governs the top level and supported command paths at any nesting depth,
      including future subcommands.

      Trade-offs: Help routing must recognize partial command paths even when the
      remaining invocation is incomplete or invalid.

      Discarded alternatives: Describing individual subcommands and showing only the
      usage problem were rejected because both require repeated maintenance as the
      command tree grows.

      Consequences: New commands and nested subcommands inherit the same
      contextual-help behavior without requiring new semantic rules.

      Revisit when: Command metadata becomes the shared source for parsing,
      validation, and generated help.
    }

    StructuredOutput {
      Decision: Treat deterministic language commands as automation interfaces
      with JSON as their stable output contract. Native sigilc owns semantic
      reports and is invoked directly by the model or operator.

      Scope: Governs CLI result shaping and transport adaptation; excludes semantic
      interpretation, compilation-status computation, LSP, and editor presentation.

      Trade-offs: Rich interactive terminal workflows remain outside the CLI.

      Consequences: Deterministic language commands expose consistent JSON
      results without compiler events or a second semantic report protocol.

      Revisit when: A reviewed interactive terminal workflow becomes a primary user
      requirement.
    }

    CheckSourceLocations {
      Decision: Expose diagnostic source locations in check text output only behind
      an opt-in --show-locations flag, reusing the existing normalized diagnostic
      file path and range.

      Scope: Governs check text presentation; excludes JSON and Markdown output,
      diagnostic generation, ordering, and exit codes.

      Design issues addressed: Text output omits locations already present in the
      diagnostic model, forcing a rerun in JSON mode, but changing default text
      output could break existing scripts and expectations.

      Consequences: Default text output stays byte-for-byte unchanged; JSON and other
      formats are unaffected; locations use the same path normalization as other CLI
      output; other commands reject the flag.

      Revisit when: Source locations become useful in default text output or in
      additional commands.
    }

    WorkspaceMutationBoundary {
      Decision: Keep workspace inspection commands read-only, restrict workspace
      initialization to missing configuration and seed-glossary files, and
      permit source mutation through explicit fmt invocation.

      Scope: Governs version, parse, check, glossary, graph, context, render, init,
      fmt and fmt --check; excludes
      explicitly requested skill-installation side effects.

      Trade-offs: Initialization performs bounded metadata creation and formatting
      performs explicit source rewrites, while inspection provides no
      automatic repair.

      Discarded alternatives: Implicit source repair, inspection-time mutation,
      formatter changes to ConfigFile or GlossaryFile, unbounded ConfigFile editing
      through a single generic command, and partial formatting after a
      selected-source error were rejected.

      Consequences: Formatting is deliberate and bounded, semantic mutation remains
      an external authoring responsibility, and user-owned glossary content is
      preserved.

      Revisit when: Formatting requires cross-file semantic rewrites, merging, or
      rollback beyond canonical source rendering.
    }

    ExplicitFormattingCommand {
      Decision: Expose core-owned deterministic formatting through sigil fmt with a
      read-only --check mode and all-selected validation before writing.

      Scope: Governs ConfigFile-selected .sigil source formatting; excludes
      ConfigFile, GlossaryFile, semantic repair, LSP formatting, and automatic
      invocation by other commands.

      Trade-offs: Large explicit selections may produce broad diffs and require every
      selected source to validate before any write.

      Design issues addressed: Authors need reproducible prose wrapping and
      structural formatting without host-specific interpretation or partial mutation.

      Discarded alternatives: Formatting during check, render, or editor
      inspection and independently implementing formatting inside the CLI were
      rejected.

      Consequences: Automation can verify canonical source without writes and
      explicit invocation can update only the selected Sigil sources.
    }

    WorkspaceInitialization {
      Decision: Seed the eight colon-qualified decision-record field labels as
      workspace-neutral initialization vocabulary and exclude their definitions from
      agent context.

      Scope: Governs a newly created GlossaryFile; excludes project-domain
      vocabulary, the umbrella phrase decision record convention, Context, and
      existing glossary content.

      Trade-offs: Including punctuation makes recognition specific to field labels
      instead of matching ordinary uses of words such as decision, scope, and
      consequences.

      Design issues addressed: Authors need definitions for the individual
      decision-record fields rather than an umbrella definition for the convention.

      Discarded alternatives: A single decision record convention entry and
      unpunctuated field terms were rejected.

      Consequences: Editors and glossary inspection explain each field independently
      without duplicating those explanations in agent context.

      Revisit when: The decision-record convention adds, removes, or renames a field.
    }

    OwnershipContext {
      Decision: Expose one core-owned implementation projection per selected
      component, aggregate its diagnostics into context command diagnostics, and
      recover failed optional ownership-source enumeration as a command-level warning
      when workspace resolution already produced meaningful context.

      Scope: Governs component and file selections for context and post-resolution
      ownership enrichment; excludes Tag-scoped CLI selection, LSP presentation,
      and required workspace loading.

      Trade-offs: Context performs a workspace implementation-source scan and may
      return incomplete ownership targets after a warning, but preserves resolved
      contract context and the shared core ownership result instead of defining a
      CLI-specific projection shape.

      Discarded alternatives: Propagating an optional ownership-source enumeration
      failure discards meaningful resolved context, while inserting the host failure
      into every core-owned projection misattributes the diagnostic.

      Consequences: Automation callers receive owned implementation targets when
      available, retain resolved contracts when optional enumeration fails, inspect
      command diagnostics for completeness, and receive separate projections for
      files containing multiple components.
    }

    OwnershipDiagnostics {
      Decision: Include deterministic ownership diagnostics in check after successful
      workspace resolution while keeping ownership target projections
      component-scoped.

      Scope: Governs check diagnostics for supported implementation sources; excludes
      context projection shape, semantic evaluation, and Sigil source edits.

      Trade-offs: check performs an additional implementation-source scan and may
      return diagnostics for annotations outside the command's component context.

      Consequences: CI and local validation expose malformed ownership links before
      context or compiler consumers attempt to use them.
    }

    ExpandFileContextSelection {
      Decision: Resolve context --file selection through both component declarations
      and expands, mapping each matching expand to its parent component identity.

      Scope: Governs component selection for CLI context by file; excludes
      --component selection, native scope resolution, and import inference.

      Trade-offs: One file can select multiple components even when it declares no
      component directly.

      Design issues addressed: Expand-only files otherwise return empty context and
      hide the parent contract and ownership projection needed to understand them.

      Discarded alternatives: Exact component-declaration file matching was rejected
      because an expand is operational context for its parent component.

      Consequences: File context reports each selected parent component once and
      includes its contract, collected expands, dependency context, glossary context,
      and ownership projection.
    }

  }

  cases {
    CliInvocation {
      Explicit help for a recognized command path reports that path's usage,
      operands, options, and immediate subcommands.

      An empty or unknown top-level command reports the problem with top-level help.

      An unknown subcommand reports the problem with help for its recognized parent
      command path.

      A missing operand, unsupported option, or extra operand reports the problem
      with help for the longest recognized command path.

      Explicit help succeeds without required operands or workspace discovery.
    }

    SkillCatalog {
      skill list includes valid bundled skills and excludes directories without
      SKILL.md.
    }

    SkillInstallation {
      Default installation targets Codex, Claude Code, OpenCode, and Pi.

      --project changes only skill destinations inside the current repository.
    }

    WorkspaceInitialization {
      init in an empty directory creates valid ConfigFile using the directory
      basename as workspace.name.

      init against existing ConfigFile reports an error and leaves it unchanged.

      init in an empty directory creates ConfigFile and GlossaryFile.

      The seeded GlossaryFile contains only Decision:, Scope:, Assumptions:,
      Trade-offs:, Design issues addressed:, Discarded alternatives:, Consequences:,
      and Revisit when:, each with agentContext false, plus an empty contexts array.

      init preserves an existing GlossaryFile unchanged.

      init in an empty directory writes an empty tools object with no providers
      or compiler profiles.
    }

    WorkspaceInspection {
      version in a valid workspace reports CLI, core, and language versions from
      their owning sources.

      check from a nested directory resolves the nearest eligible ConfigFile.

      Missing interface Concept names appear in text and JSON output while
      check exits successfully when no errors exist.

      Invalid or ambiguous Tag identities make check exit with code 1.

      render JSON includes workspace metadata and Markdown review content.

      context for a component with multiple expands reports every related expansion
      source.

      context for a component with glossary terms reports only terminology effective
      in or occurring within the component and its related expansion sources.

      context without GlossaryFile reports an absent glossary context without error.

      context for a component reports each direct dependency's public contract and
      decision sections once.

      context excludes transitive dependency decisions and non-decision private
      dependency sections.

      context with --include-dependents reports direct importing files and contextual
      public contracts declared in those files without proving component-level
      dependency.

      context for an expand-only file reports each parent component represented by
      the file and includes its collected expands and ownership projection.
    }

    SourceFormatting {
      fmt --check on canonical source exits with code 0 and writes nothing.

      fmt --check on noncanonical source exits with code 1 and writes nothing.

      fmt rewrites one valid noncanonical selected .sigil file and leaves ConfigFile
      and GlossaryFile unchanged.

      One selected source with an error prevents every selected source from being
      written.

      Formatting the result of fmt again produces no source change.
    }

    OwnershipContext {
      context for a component with valid ownership annotations reports its
      implementation targets.

      context reports malformed or detached ownership annotations through both the
      component projection and command diagnostics.

      context with an unreadable or concurrently deleted implementation source omits
      that source and still returns structured context, projections, and diagnostics
      from readable sources.

      When workspace resolution succeeds but the subsequent ownership-source
      enumeration fails, context returns selected contracts, an empty projection for
      each selected component, SIGIL_IMPLEMENTATION_SOURCE_DISCOVERY, and exit code
      0.
    }

    OwnershipDiagnostics {
      check reports valid ownership annotations without diagnostics and reports each
      malformed or unresolved ownership annotation with its source location.
    }

    GlossaryInspection {
      A workspace without GlossaryFile reports an absent glossary and no glossary
      error.

      Context overlap or spelling collision appears in text and JSON output and exits
      with code 1.
    }

    CheckSourceLocations {
      A ranged diagnostic rendered with --show-locations includes its normalized file
      path, one-based line, and one-based column.

      A diagnostic without a range rendered with --show-locations remains readable
      and omits unavailable coordinates.
    }

    ExitStatus {
      An unreadable required file produces exit code 3 rather than an
      unresolved-import diagnostic.
    }

  }
}
