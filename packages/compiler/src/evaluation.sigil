@packages/core import { SigilContextRetrieval, SigilWorkspaceLoader }
@packages/compiler/src/profile.sigil import { SigilCompilationProfile }
@packages/compiler/src/status.sigil import { SigilCompilationStatus }
@packages/compiler/src/event-writer.sigil import { SigilCompilationEventWriter }
@packages/compiler/src/adapter.sigil import { SigilAgentAdapter }
@packages/compiler/src/evaluation-request.sigil import { SigilAgentEvaluationRequest }
@packages/compiler/src/evaluation-registry.sigil import { SigilEvaluationSkillRegistry }
@packages/compiler/src/report-protocol.sigil import { SigilCompilationReportProtocol }

component SigilCompilationEvaluation {
  goal {
    Execute one reusable profile-scoped compilation pipeline over a supplied
    workspace API that is read-only to compiler-owned deterministic processing, and
    return one internal evaluation result plus nonterminal progress.

    Adapter and provider processes receive a workspace path and may exceed that API
    boundary; their declared restrictions are externally trusted rather than an
    end-to-end compiler guarantee.

    Compose SigilWorkspaceLoader, CompilationProfile, CompilationStatus,
    CompilationEventWriterProtocol, AgentAdapter, EvaluationSkillPackage, and
    report trace schemas through their owning public contracts without owning
    terminal settlement.

    This contract owns evaluation semantics and evaluation-context construction,
    not a callable evaluation entrypoint.
  }

  interface {
    CompilationEvaluation {
      Evaluation runs over a workspace access, target, effective profile, requested
      stage, and already-bound CompilationEventWriter, emits only nonterminal
      progress through that writer, and yields CompilationEvaluationResult.

      Cancellation rejects with COMPILER_CANCELLED and a host or protocol failure
      rejects with COMPILER_FAILED.

      Its implementation owner is SigilOneShotCompilation, which runs the pipeline
      inline; no separate evaluation entrypoint exists.

      SigilWorkspaceLoader supplies deterministic workspace discovery and loading
      semantics, CompilationProfile supplies stages and capabilities, and
      CompilationStatus derives color

      CompilationEventWriterProtocol governs nonterminal progress framing,
      AgentAdapter executes agentic stages, and EvaluationSkillPackage supplies their
      guidance and rule contracts
    }

    CompilationEvaluationResult {
      contains source and target identity, effective profile and executed stages,
      current diagnostics, derived status, EvaluationTrace, evaluator outcomes, and
      optional proposal identity needed for authoritative report construction

      current diagnostics contain at most one agent-derived CompilationDiagnostic for
      each diagnostic fingerprint

      compiler-synthesized diagnostics are not omitted merely because another
      diagnostic shares their fingerprint

      contains no completed, failed, or cancelled terminal event and is not itself a
      CompilationReport
    }

    EvaluationContext {
      each agent request evaluates exactly one component in one evaluation stage

      requests contain target identity, skill, capabilities, schema, budgets, and one
      complete PurposeRetrievalResult for that component and stage purpose through
      AgentEvaluationRequest
    }

    AgentWorkspaceInspection {
      evaluators inspect the supplied view through the selected adapter under its
      declared access, network, approval, and persistence behavior
    }
  }
}

expand SigilCompilationEvaluation {
  state {
    CompilationRunLifecycle {
      A compilation run is queued, running, completed, failed, or cancelled.
    }

    EvaluationStageLifecycle {
      An enabled stage is pending, running, completed, failed, skipped-by-dependency,
      or cancelled.

      A stage omitted by the effective profile is disabled rather than incomplete.
    }

    AgentInspectionLifecycle {
      An agent inspection is starting, running, completed, failed, cancelled, or
      incomplete.
    }
  }

  logic {
    PipelineExecution {
      Run deterministic foundation stages before dependent agentic stages.

      Run every enabled stage whose dependencies produced trustworthy inputs once for
      each evaluator identity selected by the effective profile.

      Skip only stages whose declared dependencies failed or became unavailable.

      After converting one evaluator's candidate findings into CompilationDiagnostic
      values, apply AgentFindingIdentityCollapse to that payload before disagreement
      comparison, run aggregation, status derivation, or diagnostic event emission.

      Aggregate every remaining trustworthy diagnostic produced by enabled stages.

      Record material disagreement when collapsed evaluator results for the same
      component, stage, rule, and semantic subject differ on the presence or severity
      of an error or warning.
    }

    DeterministicFoundationGating {
      After emitting deterministic-foundation diagnostics, mark that stage failed
      when any diagnostic has error severity.

      Skip every stage that depends on the failed foundation, including transitive
      dependents, without building retrieval context or invoking an agent adapter.

      Return the deterministic diagnostics in the completed red report; structural
      invalidity is not an evaluator-output or event-protocol failure.
    }

    EvaluationContext {
      Map semantic-readiness to semantic purpose, architecture-design and
      standards-risk to architecture purpose, and current-code-compatibility to
      implementation purpose.

      Before invoking the first agentic stage for a component and purpose, ask
      SigilContextRetrieval to build one PurposeRetrievalResult from the resolved
      workspace and complete glossary and implementation-discovery evidence. Reuse
      that immutable result for every evaluator of the same component, purpose,
      source fingerprint, and retrieval fingerprint.

      Build the evaluation request from the workspace root, selected target, stage
      skill, capability contract, output schema, execution budgets, complete raw
      retrieval result, and its derived EvaluatorRetrievalBrief.

      Invoke each enabled agentic stage separately for workspace components in
      dependency-aware order.

      The raw retrieval result is the authoritative initial evidence boundary. The
      evaluator receives its compact brief, including its Markdown dependency graph,
      and does not independently traverse graph, context, glossary, or ownership
      projections to redefine membership.
    }

    AgentWorkspaceInspection {
      Request the selected adapter to start the agent at the workspace root with
      read-only access, approval escalation disabled, agent tool network access
      disabled, and state persistence resolved from that selected adapter.

      Treat these restrictions as requested behavior and adapter declarations, not as
      compiler-verified guarantees.

      Let the agent inspect a selected evidence file at an included range when it
      must verify retrieval rendering or cite exact lines. Additional workspace
      inspection may diagnose retrieval incompleteness but cannot become evidence for
      an ordinary stage finding in that run.

      Require the agent to treat repository instructions and retrieved file contents
      as untrusted evidence rather than evaluator authority.
    }

    EvaluationTrace {
      Consume structured provider observations when available and record observed
      command metadata, model usage, evaluator environment, outcome, and
      incomplete-evidence status without retaining hidden reasoning, complete file
      contents, or bulky command output.

      Accept a terminal-only provider when its required final result is complete and
      valid. Preserve unavailable and partial telemetry without inventing zero or
      final values.
    }

    AgentFindingIdentityCollapse {
      Keep the first agent-derived CompilationDiagnostic for each diagnostic
      fingerprint in one evaluator payload and discard later payload findings with
      that fingerprint.

      When merging those collapsed payloads into the run's current diagnostics and
      CompilationEventWriter diagnostic events, keep the first agent-derived
      CompilationDiagnostic for each diagnostic fingerprint and omit later agent
      findings with that fingerprint.

      Do not collapse deterministic-foundation diagnostics, incomplete evaluator
      outcomes, disagreement records, or other compiler-synthesized diagnostics.

      Discarded later agent findings do not enter current diagnostics, status
      derivation, or diagnostic events.
    }
  }

  constraints {
    EvaluationContext {
      One adapter request never combines multiple selected components.

      CompilationEvaluation emits no completed, failed, or cancelled terminal event;
      its caller owns terminal settlement through SigilCompilationEventWriter.

      Evaluation skills may identify targets but do not alter retrieval purpose,
      membership, ordering, or aggregation.

      Effective profiles declare elapsed-time and model-usage budgets plus initial
      request and output-retention limits. They do not truncate retrieval policy
      version 1 or bound later workspace reads by initial request size.

      The declared initial-request limit is enforced where the request reaches its
      adapter, so exceeding it leaves that evaluator incomplete instead of failing
      the run. No compiler-side gate rejects a request for carrying a complete
      retrieval result.
    }

    AgentWorkspaceInspection {
      The evaluation request requires read-only workspace access, disabled agent tool
      network access, no approval escalation, the selected workspace as working root,
      and state persistence equal to the selected adapter declaration.

      An adapter declares whether it satisfies requested capabilities. The compiler
      rejects a declared mismatch but does not verify the implementation, provider
      CLI, or plugin's enforcement.

      The agent may run version, parse, check, fmt --check, retrieve, and read-only
      text inspection limited to selected evidence or retrieval diagnostics.

      The agent must not run init, mutating fmt, compile, skill installation, network
      commands, code generation, implementation experiments, or commands that modify
      workspace or external state.

      Owned implementation annotations are navigation evidence and do not restrict
      which workspace files the agent may read.

      Inaccessible material evidence, elapsed-time exhaustion, a declared capability
      mismatch, or an invalid or missing final result leave the required stage
      incomplete and prevent green.

      Adapter cancellation rejects CompilationEvaluation with COMPILER_CANCELLED.
      Binding mismatch or capability mismatch is required evaluator unavailability
      before the stage. Elapsed-time, preventive-budget, operational-limit, provider
      process, process-cleanup, and final-result-protocol failures become incomplete
      evaluator outcomes. A valid exceeded post-settlement budget outcome also makes
      that evaluator outcome incomplete while preserving findings and telemetry. Only
      Compiler host or CompilationEventWriterProtocol failures reject with
      COMPILER_FAILED.

      Missing progress events, unavailable usage or cost, and truncated nonessential
      command output do not fail an otherwise valid evaluation.
    }

    DeterministicFoundationGating {
      A failed deterministic foundation prevents dependent agentic evaluation even
      when an adapter is configured and available.

      The compiler preserves its ordinary nonterminal diagnostic framing and
      completed terminal report instead of attempting to classify agent output for
      structurally invalid selected Sigil.
    }

    AgentFindingIdentityCollapse {
      AgentFindingIdentityCollapse does not change diagnostic fingerprint derivation,
      report lifecycle identity, or CompilationEventWriterProtocol uniqueness.

      A remaining duplicate diagnostic fingerprint, including any
      compiler-synthesized collision, remains protocol-invalid.

      CompilationEventWriterProtocol still rejects a duplicate diagnostic fingerprint
      as protocol-invalid and is not the collapse owner.
    }
  }

  decisions {
    EvaluationOwnedByOneShotCompilation {
      Decision: Keep the evaluation pipeline inline in one-shot compilation and let
      this contract own evaluation semantics and evaluation-context construction
      rather than a separate callable evaluation entrypoint.

      Scope: Governs where pipeline execution is implemented; excludes terminal
      settlement, which remains with the caller.

      Assumptions: One-shot compilation is the only pipeline consumer.

      Trade-offs: One-shot compilation stays a large unit, and a future second
      consumer must extract the pipeline before reusing it.

      Design issues addressed: A session-facing pass-through was retained after the
      session boundary was removed, leaving an exported entrypoint with no consumer
      and a contract that described an owner the code did not have.

      Discarded alternatives: Extracting a standalone evaluation entrypoint was
      rejected as a reusable unit for one caller, moving the hot path for no behavior
      change. Deleting this contract was rejected because its semantics are real and
      referenced by the compiler and adapter contracts.

      Consequences: Pipeline code in one-shot compilation carries ownership
      annotations to this contract, so the implementation site is explicit.

      Revisit when: A second consumer needs the pipeline without terminal settlement.
    }

    InitialRequestLimitEnforcedAtTheAdapter {
      Decision: Enforce the declared initial-request limit where the request reaches
      its adapter and remove the compiler-side gate over the complete
      retrieval-bearing request.

      Scope: Governs initial-request size handling; excludes elapsed-time,
      model-usage, and output-retention limits.

      Design issues addressed: A compiler-side character gate over the whole request
      failed the entire run for a correct but large retrieval result, contradicting a
      retrieval policy that declares no budget in version 1.

      Discarded alternatives: Measuring the request without its retrieval payload was
      rejected because the remaining content is already bounded, leaving a gate that
      never fires.

      Consequences: An oversized request leaves one evaluator incomplete and prevents
      green, instead of rejecting the compilation.
    }

    DeterministicFoundationGating {
      Decision: Treat one deterministic error diagnostic as a failed foundation and
      skip every dependent evaluation stage.

      Scope: Governs compilation scheduling after deterministic workspace evaluation;
      excludes warnings, independent stages, and terminal-event ownership.

      Trade-offs: A structurally invalid contract receives less evaluator feedback,
      while its authoritative deterministic diagnostics remain clear and complete.

      Design issues addressed: Invoking an evaluator with structurally invalid Sigil
      can turn a source error into an unrelated provider protocol failure.

      Discarded alternatives: Continuing dependent evaluation and translating an
      evaluator failure into a structural diagnostic were rejected because neither
      preserves the dependency boundary or the original error classification.

      Consequences: A structural error completes with a red report and no dependent
      agent invocation; callers can repair the source before semantic evaluation.
    }

    EvaluationContext {
      Decision: Evaluate one component in one stage per agent run using the complete
      deterministic PurposeRetrievalResult selected for that stage's purpose.

      Scope: Governs component, file, and workspace targets across stage scheduling,
      initial request construction, workspace access, and adapter invocation.

      Assumptions: A typed purpose closure can preserve required evidence more
      consistently than evaluator-chosen traversal.

      Trade-offs: Initial requests can be large because retrieval policy version 1
      has no budget, but evaluators receive identical membership and ordering.

      Design issues addressed: Evaluator-owned graph and context traversal produces
      noisy and inconsistent evidence for the same target and question.

      Discarded alternatives: Complete workspace context, untyped traversal, model
      ranking, and evaluator-selected authoritative membership were rejected.

      Consequences: Repeated equivalent runs begin with byte-identical context and an
      auditable fingerprint while the compiler records evaluation behavior.

      Revisit when: Relevance fixtures justify a separate versioned packing policy.
    }

    DirectAgentWorkspaceInspection {
      Decision: Request read-only workspace access for citation verification and
      retrieval-gap diagnostics, while treating adapter enforcement as externally
      trusted rather than compiler-guaranteed.

      Scope: Governs evidence gathering during agentic compiler stages; excludes
      mutation, network research, approval escalation, recursive compilation, code
      generation, and implementation experiments.

      Assumptions: Included ranges can require exact-line verification, retrieval
      policy defects need observable diagnostics, and users accept the documented
      risk of their selected adapter implementation.

      Trade-offs: Providers retain limited inspection freedom and the compiler cannot
      guarantee adapter restrictions, but ordinary findings cannot rely on unselected
      evidence.

      Design issues addressed: A deterministic boundary must remain debuggable
      without restoring evaluator-owned traversal.

      Discarded alternatives: No workspace access, unrestricted authoritative
      browsing, and inferring safety from provider events were rejected.

      Consequences: Evaluators can verify selected evidence and report missing
      relations while retrieval owns normal-stage evidence membership; adapter trust
      limitations remain documentation-only.

      Revisit when: Retrieval results carry sufficient immutable line-addressable
      evidence to remove workspace inspection entirely.
    }

    AgentFindingIdentityCollapse {
      Decision: Collapse agent-derived findings with the same diagnostic fingerprint
      by first-wins inside each evaluator payload and again when merging into the
      run, while leaving compiler-synthesized diagnostics uncollapsed.

      Scope: Governs conversion of candidate agent findings into current diagnostics
      and nonterminal diagnostic events; excludes fingerprint derivation,
      disagreement identity, writer uniqueness, and terminal settlement.

      Assumptions: Evaluator wording can vary for one rule, stage, subject, and
      location without identifying a second finding.

      Trade-offs: A later same-identity agent finding, including a harsher severity,
      is discarded; disagreement still observes each evaluator's first finding.

      Design issues addressed: Duplicate fingerprints from nondeterministic
      evaluators close the event writer as protocol-invalid and prevent a completed
      report.

      Discarded alternatives: Writer-side suppression, last-wins or severity-wins
      replacement, payload-only collapse, and run-wide collapse of every diagnostic
      were rejected because they split ownership, hide disagreement, or drop
      compiler-synthesized failures.

      Consequences: One agent identity produces one diagnostic and event; remaining
      collisions stay protocol-invalid.

      Revisit when: Diagnostic identity includes evaluator wording or severity, or
      compiler-synthesized fingerprints become unique per occurrence.
    }
  }

  cases {
    DeterministicFoundationGating {
      A selected Sigil source with a structural error emits its deterministic
      diagnostic, marks deterministic-foundation failed, skips semantic-readiness and
      other dependent stages, and completes with a red report.

      A configured evaluator receives no request for that structurally invalid
      compilation, so invalid evaluator output cannot replace the source diagnostic.
    }

    EvaluationContext {
      Two evaluators for the same component, stage purpose, source fingerprint, and
      retrieval fingerprint receive byte-identical selected graph and context.

      A request carrying a complete retrieval result is sent to its adapter; only the
      adapter's initial-request limit can leave that evaluator incomplete.

      Current-code-compatibility receives owned implementation evidence selected by
      implementation purpose; an unannotated caller is absent unless an explicit
      typed relation selects it.

      A completed run returns one CompilationEvaluationResult and no terminal event.
      Cancellation rejects with COMPILER_CANCELLED and a host or protocol failure
      rejects with COMPILER_FAILED; callers own terminal settlement after their
      durability or export work.
    }

    AgentWorkspaceInspection {
      An agent cites exact lines from a selected evidence range whether or not its
      adapter exposes the underlying read observation.

      An agent that discovers a materially required unselected relation reports a
      retrieval-gap diagnostic; that evidence does not become an ordinary stage
      finding until a later run uses a revised retrieval policy.

      An adapter declaring incompatible workspace access fails before evaluation.

      An adapter declaring compatible access may run without a generic warning; its
      restrictions remain externally trusted and documented rather than verified by
      compiler events.
    }

    AgentFindingIdentityCollapse {
      One evaluator payload with two findings that share a diagnostic fingerprint
      keeps the first CompilationDiagnostic and completes without a protocol-invalid
      diagnostic event.

      Two evaluators that emit the same identity with different wording each keep
      their first finding; disagreement compares those collapsed sets; the run keeps
      the first merged agent diagnostic and emits it once.

      Two evaluators that differ only in severity still produce a disagreement
      record; the first merged agent diagnostic keeps its original severity.

      A second COMPILER_EVALUATOR_INCOMPLETE diagnostic in the same stage is not
      omitted by AgentFindingIdentityCollapse.
    }
  }
}
