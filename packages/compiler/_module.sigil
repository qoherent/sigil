@packages/core import { SigilCore, SigilContextRetrieval }
@packages/compiler/src/proposal-workspace.sigil import { SigilProposalWorkspace }
@packages/compiler/src/session.sigil import { SigilCompilationSession }
@packages/compiler/src/session-store.sigil import { SigilCompilationSessionStore }
@packages/compiler/src/profile.sigil import { SigilCompilationProfile }
@packages/compiler/src/status.sigil import { SigilCompilationStatus }
@packages/compiler/src/event-protocol.sigil import { SigilCompilationEventProtocol }
@packages/compiler/src/adapter.sigil import { SigilAgentAdapter }
@packages/compiler/src/evaluation-registry.sigil import { SigilEvaluationSkillRegistry }
@packages/compiler/src/evaluation.sigil import { SigilCompilationEvaluation }
@packages/compiler/src/report-protocol.sigil import { SigilCompilationReportProtocol }
@packages/compiler/src/history-store.sigil import { SigilCompilationHistoryStore }
@packages/compiler/src/report-export.sigil import { SigilCompilationReportExporter }
@packages/compiler/src/session-factory.sigil import { SigilCompilationSessionFactory }

component SigilCompiler {
  goal {
    Give designers and architects a compiler-like improvement loop for high-level
    Sigil contracts through profile-scoped deterministic and agentic evaluation.

    Orchestrate evidence-backed evaluation without modifying the selected
    workspace, replacing human design approval, or moving semantic judgment into
    SigilCore.
  }

  interface {
    CompilationInvocation {
      compile(workspacePath, target, profileName, CompilationOptions?) streams
      CompilationEvent

      successful settlement returns the authoritative CompilationReport; cancellation
      and failure return no report

      SigilCompilationEventProtocol owns terminal event framing and transport-loss
      precedence; narrower compiler components own their stable failure identities
    }

    CompilationOptions {
      may select a stage or focus, control optional history and report export, supply
      cancellation, and receive non-authoritative host warnings

      SigilCompilationProfile, SigilCompilationHistoryStore,
      SigilCompilationReportExporter, and SigilCompilationEventProtocol own those
      option semantics
    }

    CompilationTarget {
      CompilationTarget is a tagged union of component, file, location, and workspace

      SigilCore owns path, source-position, range, and declaration resolution;
      SigilCompiler's CompilationTarget logic owns component-set selection and
      scheduling; SigilContextRetrieval owns evaluation evidence membership
    }
  }
}

expand SigilCompiler {
  constraints {
    HumanAuthorityBoundary {
      Green status is evidence that one exact source snapshot passed one exact
      profile.

      Green status does not approve the design, authorize implementation, or replace
      an accountable human review.
    }
  }

  decisions {
    CompilerBoundary {
      Decision: Place agent orchestration in a separate @qoherent/sigil-compiler
      package and expose it through thin host façades.

      Scope: Governs agentic Sigil compilation; excludes deterministic language
      interpretation owned by SigilCore.

      Trade-offs: Distribution gains another package and compatibility boundary.

      Design issues addressed: Agentic evaluation must not weaken the deterministic
      core contract.

      Discarded alternatives: Making SigilCore or SigilCli directly own semantic
      evaluation was rejected.

      Consequences: CLI, editors, and future hosts share one compiler protocol
      without duplicating orchestration.
    }

    HumanAuthorityBoundary {
      Decision: Treat green as profile-scoped evidence rather than design approval or
      implementation authorization.

      Scope: Governs every compilation report and downstream workflow.

      Consequences: Critical design handoff retains accountable human review.
    }

    InvalidCompilationInvocation {
      Decision: Reject an unknown target, profile, stage, or focus through one stable
      COMPILER_INVALID_INVOCATION caller error.

      Scope: Governs compiler invocation validation; excludes evaluator availability,
      cancellation, and host or protocol failure.

      Trade-offs: One code covers several caller-correctable input categories.

      Consequences: Hosts receive one predictable no-report failure contract without
      multiplying public error identities.
    }

  }
}
