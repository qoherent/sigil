; Only admitted implementation observations establish actual behavior. Design
; commitments are obligations/prohibitions, never actual rows.
(relation entity (String String String))
(relation member (String String String))
(relation delivery (String String String))
(relation action (String String String String))
(relation observed-number (String String f64 String))
(relation actual (String String String String))
(relation actual-number (String String f64 String))
(relation owner (String String String))
(relation rightful (String String))
(relation exclusive (String String))
(relation obligation (String String String String String))
(relation forbidden (String String String String String))
(relation budget (String String String f64))
(relation required-budget (String))
(function answered (String) i64 :merge (max old new))
(relation breach (String String String String String String))
(relation unanswered (String String String String))
(ruleset closure)
(ruleset diagnostics)
(rule ((member e c m) (delivery e t f)) ((actual c "provides" t f)) :ruleset closure)
(rule ((member e c m) (action e p t f)) ((actual c p t f)) :ruleset closure)
(rule ((member e c m) (action e "uses" t f) (entity t "Component" ow)) ((actual c "dependsOn" t f)) :ruleset closure)
(rule ((member e c m) (action e "invokes" t f) (entity t "Component" ow)) ((actual c "dependsOn" t f)) :ruleset closure)
(rule ((member e c m) (action e "uses" t f) (entity t "Tag" ow) (!= ow ""))
      ((actual c "dependsOn" ow f)) :ruleset closure)
(rule ((member e c m) (action e "invokes" t f) (entity t "Tag" ow) (!= ow ""))
      ((actual c "dependsOn" ow f)) :ruleset closure)
(rule ((member e c m) (action e "dependsOn" t f) (entity t "Tag" ow) (!= ow ""))
      ((actual c "dependsOn" ow f)) :ruleset closure)
(rule ((delivery e t r) (observed-number e p n f)) ((actual-number t p n f)) :ruleset closure)
(rule ((member e c r) (observed-number e p n f)) ((actual-number c p n f)) :ruleset closure)
(rule ((obligation id s p o law)) ((set (answered id) 0)) :ruleset closure)
(rule ((obligation id s p o law) (actual s p o f)) ((set (answered id) 1)) :ruleset closure)
(rule ((obligation id s "provides" o "requires") (actual s "dependsOn" b f) (actual b "provides" o g)) ((set (answered id) 1)) :ruleset closure)
(rule ((obligation id s "owner" s "required-state-owner") (owner a s f)) ((set (answered id) 1)) :ruleset closure)
(rule ((forbidden id s p o law) (actual s p o f)) ((breach law id f "" s o)) :ruleset closure)
(rule ((exclusive id t) (owner a t f) (owner b t g) (!= a b)) ((breach "exclusive-ownership" id f g a t)) :ruleset closure)
(rule ((exclusive id t) (rightful t a) (owner b t f) (!= a b)) ((breach "exclusive-ownership" id f "" b t)) :ruleset closure)
(rule ((budget id s p bound)) ((set (answered id) 0)) :ruleset closure)
(rule ((budget id s p bound) (actual-number s p n f)) ((set (answered id) 1)) :ruleset closure)
(rule ((budget id s p bound) (actual-number s p n f) (> n bound)) ((breach "numeric-budget" id f "" s p)) :ruleset closure)
(rule ((obligation id s p o law) (= (answered id) 0)) ((unanswered law id s o)) :ruleset diagnostics)
(rule ((budget id s p bound) (required-budget id) (= (answered id) 0)) ((unanswered "numeric-budget" id s p)) :ruleset diagnostics)
