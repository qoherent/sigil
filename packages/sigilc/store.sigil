component SigilProjectionStore {
  goal {
    Perform *DisposableCleanup* of cached source projections while preserving
    stored claims readings and authored workspace data.
  }

  interface {
    DisposableCleanup The sigilc clean command removes only the worlds and
    trees entries from the selected store. It tolerates a missing store and
    removes symlink artifacts themselves without following their targets. It
    preserves claims readings, authored sources, workspace configuration, and
    external preparation input. Cleanup takes no world lock and creates no
    cache directories.
  }
}
