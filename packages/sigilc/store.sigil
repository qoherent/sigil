component SigilProjectionStore {
  goal {
    Remove disposable source caches while preserving *claims readings*.
  }

  interface {
    DisposableCleanup {
      Clean removes worlds and trees from the selected store, including worlds
      left by older versions. Tolerate absent cache directories and malformed old
      indexes without interpreting their contents. Remove symlink artifacts
      themselves without following their targets. Preserve claims readings,
      authored sources, workspace configuration and external preparation inputs.
      Cleanup takes no world lock and creates no cache directories.
    }
  }
}
