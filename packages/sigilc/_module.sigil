component SigilSemanticCompiler {
  goal {
    Derive disposable Design and Implementation worlds using fixed semantic laws
    while keeping *language interpretation* and external workers separate.
  }

  constraints {

    SourceTrees {
      SourceTrees admit only authored sources: no obligations, rules,
      implementation evidence, model configuration or production metadata. Invalid
      UTF-8 cannot enter, and invalid input never supplies a completed verdict.
    }
  }

  interface {
    SourceTrees {
      sigilc owns *parsing and language resolution* for compilation. It reads the
      workspace root and keeps one content-addressed tree per source, with an
      interface hash per component. A dependent sees only the interfaces it imports.
    }
    Exposes language interpretation to direct consumers.

  }
}
