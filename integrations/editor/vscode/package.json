{
  "name": "sigil",
  "displayName": "Sigil",
  "description": "Language support and component previews for Sigil.",
  "version": "0.8.0",
  "publisher": "sigil-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qoherent/sigil.git",
    "directory": "integrations/editor/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sigil",
    "language",
    "rationale",
    "architecture"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Sigil language features require a trusted file-backed workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Sigil language features require a file-backed workspace."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sigil",
    "onCommand:sigil.openPreview",
    "onCommand:sigil.compileFile",
    "onCommand:sigil.compileWorkspace",
    "onCommand:sigil.selectCompilationFocus"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sigil",
        "aliases": [
          "Sigil",
          "sigil"
        ],
        "extensions": [
          ".sigil"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sigil",
        "scopeName": "source.sigil",
        "path": "./syntaxes/sigil.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "sigil",
        "scopes": {
          "tag": [
            "entity.name.type.tag.sigil"
          ],
          "term": [
            "entity.name.type.tag.sigil"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "sigil.openPreview",
        "title": "Sigil: Open Preview",
        "category": "Sigil",
        "icon": "$(open-preview)"
      },
      {
        "command": "sigil.compileFile",
        "title": "Sigil: Compile File",
        "category": "Sigil"
      },
      {
        "command": "sigil.compileWorkspace",
        "title": "Sigil: Compile Workspace",
        "category": "Sigil"
      },
      {
        "command": "sigil.selectCompilationFocus",
        "title": "Sigil: Select Compilation Focus",
        "category": "Sigil",
        "icon": "$(play)"
      }
    ],
    "configuration": {
      "title": "Sigil",
      "properties": {
        "sigil.compile.executable": {
          "type": "string",
          "default": "sigilc",
          "description": "Path to the standalone native sigilc compiler."
        },
        "sigil.compile.focus": {
          "type": "string",
          "enum": [
            "ask",
            "design",
            "implementation"
          ],
          "default": "ask",
          "description": "Default compilation focus used by editor commands."
        },
        "sigil.compile.languageExecutable": {
          "type": "string",
          "default": "sigil",
          "description": "Path to the language CLI providing export design."
        },
        "sigil.compile.selection": {
          "type": "string",
          "default": "",
          "description": "Native Implementation selection JSON path, relative to the workspace or absolute. Required for Implementation focus."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sigil.openPreview",
          "when": "editorLangId == sigil"
        },
        {
          "command": "sigil.compileFile",
          "when": "editorLangId == sigil"
        },
        {
          "command": "sigil.compileWorkspace"
        }
      ],
      "editor/title": [
        {
          "command": "sigil.openPreview",
          "when": "editorLangId == sigil",
          "group": "navigation"
        },
        {
          "command": "sigil.selectCompilationFocus",
          "when": "editorLangId == sigil",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:extension": "npm run build && node scripts/run-extension-tests.mjs",
    "test": "npm run check && npm run test:unit",
    "package": "npm run build && node scripts/package-extension.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "entities": "7.0.0",
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/deno": "2.7.0",
    "@types/node": "^24.10.0",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
