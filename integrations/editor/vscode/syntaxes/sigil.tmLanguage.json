{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sigil",
  "scopeName": "source.sigil",
  "patterns": [
    {
      "include": "#fences"
    },
    {
      "include": "#links"
    },
    {
      "include": "#escapes"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#braces"
    }
  ],
  "repository": {
    "imports": {
      "patterns": [
        {
          "begin": "^\\s*(@[^\\s]+)(?:\\s+(from)\\s+([A-Za-z][A-Za-z0-9_]*))?\\s+(import)\\s*(\\{)",
          "end": "\\}",
          "name": "meta.import.sigil",
          "beginCaptures": {
            "1": {
              "name": "string.unquoted.import-path.sigil"
            },
            "2": {
              "name": "keyword.control.import.sigil"
            },
            "3": {
              "name": "entity.name.type.component.sigil"
            },
            "4": {
              "name": "keyword.control.import.sigil"
            },
            "5": {
              "name": "punctuation.section.braces.begin.sigil"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.end.sigil"
            }
          },
          "patterns": [
            {
              "match": "[^,}\\s](?:[^,}\\r\\n]*[^,}\\s])?",
              "name": "entity.name.type.tag.sigil"
            },
            {
              "match": ",",
              "name": "punctuation.separator.sigil"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(component)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.sigil"
            },
            "2": {
              "name": "entity.name.type.component.sigil"
            }
          }
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "match": "^\\s*(goal|interface|state|logic|constraints|decisions|cases)\\s*(\\{)",
          "captures": {
            "1": {
              "name": "keyword.other.section.sigil"
            },
            "2": {
              "name": "punctuation.section.braces.begin.sigil"
            }
          }
        }
      ]
    },
    "braces": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.braces.sigil"
        }
      ]
    },
    "fences": {
      "patterns": [
        {
          "begin": "^\\s*(`{3,})[^`]*$",
          "end": "^\\s*\\1`*\\s*$",
          "name": "markup.fenced_code.block.sigil",
          "contentName": "string.quoted.literal.sigil"
        }
      ]
    },
    "links": {
      "patterns": [
        {
          "match": "!?\\[(?:\\\\.|[^\\]\\\\])*\\]\\((?:\\\\.|[^()\\\\]|\\([^()]*\\))*\\)",
          "name": "markup.underline.link.sigil"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.sigil"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "match": "^\\s*([^{}*]+?)\\s*(\\{)\\s*$",
          "captures": {
            "1": {
              "name": "entity.name.type.tag.sigil"
            },
            "2": {
              "name": "punctuation.section.braces.begin.sigil"
            }
          }
        },
        {
          "match": "(?<![\\\\*])\\*([^*\\r\\n]+)\\*(?!\\*)",
          "captures": {
            "1": {
              "name": "entity.name.type.tag.sigil"
            }
          }
        }
      ]
    }
  }
}
