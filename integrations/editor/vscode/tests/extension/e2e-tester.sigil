component SigilVsCodeE2ETester {
  goal {
    Verify the VS Code integration through an isolated extension host.

    Exercise editor commands and observable compiler integration behavior at the VS
    Code API boundary without depending on a user's global editor state.
  }

  interface {
    ExtensionHostTest {
      launches the extension development host with the Sigil integration and a
      controlled file-backed workspace

      invokes contributed language, preview, and compilation commands through the VS
      Code command API

      inspects native scope, named states, structured output and ranged diagnostics
    }
  }

  constraints {
    TestRunner {
      uses @vscode/test-electron to launch a separate VS Code extension host

      disables unrelated extensions and supplies a temporary test workspace or
      controlled fixture state

      uses current built language and native compiler executables for real scope,
      diagnostic and unavailable-comparison assertions; separate unit fixtures
      exercise all state/exit pairs without invoking a model

      does not mutate the repository's user workspace or depend on global VS Code
      settings
    }
  }

  cases {

    TagAndCoordinateNavigation {
      Navigate a real selected provider Tag, preserving consumer hover context and
      owner definition. Exercise supplementary Unicode and CRLF in both LSP positions
      and native schema 2 byte-range diagnostics, including related locations; stale
      source digest prevents location publication.

      Current native fixtures use schema 2 and compatible prepared projections
      produced outside the editor command. The retained legacy skill fixture remains
      a separately selected 0.7 check.
    }
    ExtensionHostLifecycle {
      the tester starts the extension host, discovers the Sigil extension, waits
      until hover and definition providers respond for the fixture, and exits with a
      passing result after all assertions

      an extension activation, readiness, or assertion failure exits the test run
      with the failing assertion and captured host output
    }

    LanguageFeatures {
      opening a Sigil fixture provides a hover and definition through the VS Code
      language-feature command API
    }

    FileCompilationCommand {
      Compile File uses the active physical Sigil path as an ordered native root, and
      the result exposes import and ownership dependencies. Language export and
      sigilc produce native ranged findings that appear in editor diagnostics.
      Missing Design reconstruction keeps Implementation comparison unavailable. The
      obsolete component alias is not registered.
    }

    ExternalCompilerFailure {
      a missing native executable returns no successful report, writes the failure to
      Sigil output, clears previous findings and shows actionable error text
    }

    DirtyDocument {
      invoking Compile File for an unsaved Sigil document does not start the external
      compiler and shows a warning asking the user to save the document
    }

    DocumentPreview {
      invoking Open Preview through the command API opens a Markdown preview for the
      whole active Sigil document
    }

    TestIsolation {
      unrelated installed extensions and the user's global compiler executable do not
      determine the command-contract assertions
    }
  }
}
