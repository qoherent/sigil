component SigilSkillCompatibility {
  goal {
    Declare the language frontend and native tool versions supported by this
    portable skill, independently of the skill artifact version.
  }

  interface {
    SkillCompatibility {
      compatibility.json contains exactly cliVersion, coreVersion, sigilVersion and
      sigilcVersion as strings.

      Tool versions are stable caret ranges; the language version is exact. VERSION
      owns only the skill artifact version.

      Inspect sigil and sigilc versions independently.

      The archive version does not imply both binaries share a version or provide a
      removed command.
    }
  }
}

expand SigilSkillCompatibility {
  logic {
    SkillCompatibility {
      For a stable range ^M.m.p require at least M.m.p and less than the next major
      when M is nonzero, next minor for ^0.m.p when m is nonzero, or next patch for
      ^0.0.p.

      Reject prereleases; ignore build metadata for precedence.

      Compare the configured language version exactly.

      Compare core only when its actual version is available from the selected build;
      do not invent it from the CLI version.

      Report unavailable version evidence explicitly.
    }
  }

  constraints {
    SkillCompatibility {
      Report malformed metadata, unsupported versions or unavailable executables with
      the actual path and version evidence.

      Do not silently invoke a global older binary or add a compatibility wrapper.

      Use a supported installed or repository-built tool for the affected operation.

      Missing workspace configuration is a bootstrap condition, not evidence of
      incompatible native protocol.

      Do not change user files to pass compatibility.
    }
  }

  cases {
    SkillCompatibility {
      CLI 0.8.0 and sigilc 0.1.0 can be supported together with language 0.8.0; their
      distinct versions are intentional. A removed command remains removed.
    }
  }
}
