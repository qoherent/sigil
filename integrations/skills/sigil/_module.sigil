@spec/language.sigil import { SigilLanguage }
@packages/cli import { SigilCli }
@integrations/skills/sigil/workspace-bootstrap.sigil import { SigilWorkspaceBootstrap }
@integrations/skills/sigil/design-compilation-review.sigil import { SigilDesignCompilationReview }
@integrations/skills/sigil/compilation-execution.sigil import { SigilCompilationExecution }
@integrations/skills/sigil/standards-review.sigil import { SigilStandardsReview }
@integrations/skills/sigil/authoring-workflow.sigil import { SigilAuthoringWorkflow }
@integrations/skills/sigil/glossary-workflow.sigil import { SigilGlossaryWorkflow }
@integrations/skills/sigil/implementation-workflow.sigil import { SigilImplementationWorkflow }
@integrations/skills/sigil/design-conversation.sigil import { SigilDesignConversation }
@integrations/skills/sigil/design-intake.sigil import { SigilDesignIntake }
@integrations/skills/sigil/external-guidance-evidence.sigil import { ExternalGuidanceEvidence }
@integrations/skills/sigil/compatibility.sigil import { SigilSkillCompatibility }

component SigilSkill {
  goal {
    Provide coding-agent hosts with one reusable workflow for designing, reviewing,
    reconciling, and implementing software through validated written Sigil
    contracts.

    Keep ambiguity resolution, evidence classification, standards review, and human
    approval in the host workflow while consuming native Design and Implementation
    reports as scoped semantic evidence.
  }

  interface {
SkillPackage {
      SKILL.md is the portable workflow entrypoint

      Package validation checks metadata and references and executes documented
      native commands with disposable fixtures. Fixed Turtle exercises protocol; it
      never establishes independent reconstruction of the application.

      VERSION owns the skill artifact version

      compatibility.json declares compatible CLI, core, language and sigilc versions

      SigilSkillCompatibility owns compatibility schema, range evaluation, and
      failure behavior before workspace interpretation

      SigilLanguage and SigilCli remain available through their imported owning
      contracts

      references are loaded progressively when their procedures apply

      host installation locations and adapters do not alter workflow semantics
    }

    SkillWorkflow {
      SKILL.md dispatches applicable procedures to the imported workspace, design-
      compilation, compilation-execution, standards, authoring, glossary,
      implementation, design-intake, design-conversation, and external-evidence
      components

      SigilWorkspaceBootstrap, SigilDesignCompilationReview,
      SigilCompilationExecution, SigilStandardsReview, SigilAuthoringWorkflow,
      SigilGlossaryWorkflow, SigilImplementationWorkflow, SigilDesignConversation,
      and ExternalGuidanceEvidence remain available through their imported owning
      contracts

      SigilDesignIntake remains available through its imported owning contract

      explicit imports expose those cohesive workflow components without making the
      summary source own their operational policy or mutable lifecycle
    }

  }
}

expand SigilSkill {
  constraints {
SkillPackage {
      The skill workflow remains semantically host-neutral.

      When an applicable required reference is missing, unreadable, or invalid,
      report its identity and failure reason and stop the affected workflow. Do not
      access inapplicable references merely to test their availability.

      Each host adapter may define discovery and presentation mechanics but does not
      redefine native semantics or the user's authorization.

      Skill artifact version ownership is independent from language and distributable
      tool versions.

      Compatibility policy remains outside this summary source and is exposed through
      the imported SigilSkillCompatibility component.
    }
  }

  decisions {
    HostNeutralSkillBoundary {
      Decision: Keep workflow semantics host-neutral, let adapters vary only
      discovery and presentation, and keep skill artifact version ownership separate
      from language and tool versions.

      Scope: Governs the portable skill package, its host adapters, artifact release,
      and compatibility declaration; excludes host-specific installation mechanics.

      Trade-offs: Hosts preserve the user's scope and existing authorization while
      checking the independently versioned language and native tools.

      Design issues addressed: Host-specific authority rules and duplicated version
      ownership would make the same skill behave differently across installations.

      Discarded alternatives: Adapter-defined approval and one shared version across
      skill, CLI, core, and language artifacts were rejected.

      Consequences: SKILL.md remains portable while compatibility.json explicitly
      binds it to supported tool and language versions.
    }

  }
}
