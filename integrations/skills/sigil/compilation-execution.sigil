@packages/cli import { SigilCli }
@packages/sigilc import { SigilSemanticCompiler }
@packages/sigilc/scope.sigil import { SigilComparisonScope }

component SigilCompilationExecution {
  goal {
    Guide an external caller through language export and direct native semantic
    operations while preserving input identity and independent interpretation.
  }

  interface {
    CompilationExecution {
      sigilc reads the workspace root itself; no export step is needed.

      Call sigilc directly for scope, stale, prepare, ingest, entities, compile,
      compare and clean.

      SigilSemanticCompiler supplies native JSON paired with the actual process
      exit and stderr.

      Use one ordered SigilComparisonScope consistently across related operations.
      Scope reports semantic membership and caller priority without asserting a
      comparison result.

      Prepare produces copied semantic inputs and an immutable binding.json.
      An external interpreter returns Turtle to the matching ingest command.
    }
  }
}

expand SigilCompilationExecution {
  logic {
    CompilationExecution {
      Rerun sigilc after authored, configuration or glossary changes.

      Inspect native membership and freshness before preparing stale sources.

      Prepare into a new directory outside selected sources.

      Design interpreters receive design.json and ontology.json.

      Implementation interpreters receive exactly captured source bytes,
      ontology.json and catalog.json.

      Submit the returned Turtle with the unchanged matching binding.json. A
      rejected submission may be repaired externally and retried with that
      binding; changed inputs require a fresh preparation.

      Compile current Design, then use its available identity catalog to prepare
      independent Implementation projections and compare selected worlds.

      Preserve source and tool identities with actual output.

      Resolve a reported prerequisite or invocation failure before retrying the
      affected operation.

      Native ingest errors include an actionable hint for common identity,
      ontology and stale-input failures. Preserve the original error and use its
      hint for the next temporary-construction repair.
    }
  }

  constraints {
    CompilationExecution {
      Interpretation, isolation, retries, source edits and scheduling remain
      external.

      Never edit source bytes, binding.json or a published projection while
      repairing a rejected Turtle result.

      Do not add a TypeScript wrapper, provider, stage or orchestration service.

      Do not give Implementation interpreters Design prose, neighboring code,
      caller records or comparison feedback.

      Frozen identities are names, not proof.

      Design gates report Coherent or Loose with exit zero, Disjoint with exit one.

      Implementation gates report Closed or Converged with exit zero, Drift with
      exit one.

      Loose and Converged are yellow with warnings, not failed runs.

      Usage exits two.

      Runtime failure or unavailable comparison exits three; unavailable
      Implementation and comparison remain unset.

      Scope exit zero is inspection only; stale exit one means freshness work,
      and entities exit one means an unavailable catalog.

      Do not infer a semantic color from a generic exit code.

      Generated worlds are ignored and disposable.

      Scope order does not schedule external work, prove delivery, or invalidate
      otherwise unchanged semantic bindings.
    }
  }

  cases {
    CompilationExecution {
      Reordering roots preserves membership while native focus_order exposes the
      new caller priority.

      Reuse that output instead of a second priority table. A changed source
      causes stale ingestion rejection; recapture and reconstruct the affected
      input rather than editing the binding to force acceptance.

      Missing Design reconstruction leaves comparison unavailable.

      A native ingest rejection returns the next actionable repair hint to the
      external interpreter. It cannot turn rejection into acceptance by changing
      source bytes, binding.json or hand-authored facts.

      A source with no supported assertion may publish a truthful zero-fact
      Turtle result.
    }
  }
}
